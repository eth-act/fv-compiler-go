/-- The op's name in the gofv export (`docs/contracts/export.md`): arch prefix and name
(`ARM64ADD`; generic ops: `name`). -/
def exportName (o : Op) : String := o.archName ++ o.name

/-- The Go constant's value (`Op(o)` in the pinned opGen.go; other archs and the SIMD
entries make it differ from `ctorIdx`). -/
def goNum (o : Op) : Nat :=
  let i := o.ctorIdx
  if i < 1 then i + 0 else
  if i < 355 then i + 4291 else
  i + 6042

/-- Inverse of `goNum`: the exported Op with Go value `n`, if any. -/
def ofGoNum? (n : Nat) : Option Op :=
  if 0 ≤ n ∧ n < 1 then all[n - 0]? else
  if 4292 ≤ n ∧ n < 4646 then all[n - 4291]? else
  if 6397 ≤ n ∧ n < 6842 then all[n - 6042]? else
  none

end Op

instance : Hashable Op := ⟨fun o => hash o.ctorIdx⟩
instance : ToString Op := ⟨Op.name⟩
instance : Repr Op := ⟨fun o _ => .text ("GoFV.SSA.Op." ++ if o = .Invalid then "Invalid" else o.exportName)⟩

