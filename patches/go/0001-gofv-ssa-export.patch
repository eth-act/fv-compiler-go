+// gofvPosFL renders a resolved position as <FileIndex>:<RelLine>.
+func gofvPosFL(p src.Pos) string {
+	return fmt.Sprintf("%d:%d", p.FileIndex(), p.RelLine())
+}
+
+// gofvRanges renders a range list as <start>:<end>,… ("-" when empty).
+func gofvRanges(rs []dwarf.Range) string {
+	var ss []string
+	for _, r := range rs {
+		ss = append(ss, fmt.Sprintf("%d:%d", r.Start, r.End))
+	}
+	return gofvListP(ss)
+}
+
+// dwsym returns the reference of a DWARF state symbol ("-" for nil).
+func (x *gofvProgExporter) dwsym(s dwarf.Sym) string {
+	if s == nil {
+		return "-"
+	}
+	ls, _ := s.(*obj.LSym)
+	return x.sym(ls)
+}
+
+// dwvar writes var line k: every dwarf.Var field and its location list (- none, v<varID>
+// the FuncDebug variable's, e<entries> one dwarfgen built).
+func (x *gofvProgExporter) dwvar(d *gofvDwarfFn, k int, v *dwarf.Var) {
+	list := "-"
+	if v.PutLocationList != nil {
+		if l, ok := d.lists[v]; !ok {
+			list = "?"
+			x.warn("location list of %s not recorded", v.Name)
+		} else if l.varID >= 0 {
+			list = "v" + strconv.Itoa(l.varID)
+		} else {
+			var es []string
+			for _, e := range l.list {
+				es = append(es, gofvLocEntry(e))
+			}
+			list = "e" + strings.Join(es, ",")
+		}
+	}
+	fmt.Fprintf(&x.body, "var %d %d %s %d %d %d %d %d %d %s %s %d %d %d %d %d %d %s\n", k, v.Scope,
+		gofvQuoteP(v.Name), v.Tag, gofvBoolP(v.WithLoclist), gofvBoolP(v.IsReturnValue),
+		gofvBoolP(v.IsInlFormal), v.DictIndex, v.StackOffset, x.dwsym(v.Type), gofvQuoteP(v.DeclFile),
+		v.DeclLine, v.DeclCol, v.InlIndex, v.ChildIndex, gofvBoolP(v.IsInAbstract), v.ClosureOffset, list)
+}
+
+// dwdata writes a data line for a DWARF symbol, with child-DIE reference addends written as
+// they are before Finalize (ReferenceChildDIE may already have added an offset).
+func (x *gofvProgExporter) dwdata(s *obj.LSym, refs []gofvDIERef) {
+	k := x.sym(s)
+	sub := map[int]int64{}
+	for _, r := range refs {
+		sub[r.ridx] += r.off
+	}
+	fmt.Fprintf(&x.body, "data %s %s %d %d %x %s %d\n", k, s.Type, s.Size, s.Align, uint32(s.Attribute),
+		gofvHexP(s.P), len(s.R))
+	for i, r := range s.R {
+		fmt.Fprintf(&x.body, "reloc %d %d %s %d %s\n", r.Off, r.Siz, r.Type, r.Add-sub[i], x.sym(r.Sym))
+	}
+}
+
+// dwarf writes the dwarf section: populateDWARF's state (dwarfgen.Info's scopes, variables
+// and inlined calls, E2) and the function's DWARF symbols at the end of Compile.
+func (x *gofvProgExporter) dwarf() {
+	s := x.fn.LSym
+	gofvDwarf.Lock()
+	d := gofvDwarf.fns[s]
+	delete(gofvDwarf.fns, s)
+	gofvDwarf.Unlock()
+	x.section("dwarf", func() {
+		if d == nil || d.fnstate == nil {
+			return
+		}
+		fs := d.fnstate
+		info, _ := fs.Info.(*obj.LSym)
+		loc, _ := fs.Loc.(*obj.LSym)
+		ranges, _ := fs.Ranges.(*obj.LSym)
+		absfn, _ := fs.Absfn.(*obj.LSym)
+		fmt.Fprintf(&x.body, "dwfn %s %s %s %s %s %s %s %d %d %d %d\n", x.dwsym(fs.Info), x.dwsym(fs.Loc),
+			x.dwsym(fs.Ranges), x.dwsym(fs.Absfn), x.sym(d.lines), gofvQuoteP(fs.Name), gofvPosFL(fs.StartPos),
+			gofvBoolP(fs.External), gofvBoolP(d.wrapper), gofvBoolP(fs.UseBASEntries), base.Ctxt.DwTextCount)
+		// Every distinct variable once (by identity: putscope skips the inlined calls'
+		// variables), the scopes' first.
+		vix := map[*dwarf.Var]int{}
+		var vs []*dwarf.Var
+		ref := func(v *dwarf.Var) string {
+			k, ok := vix[v]
+			if !ok {
+				k = len(vs)
+				vix[v] = k
+				vs = append(vs, v)
+			}
+			return strconv.Itoa(k)
+		}
+		var scs, ics []string
+		for k, sc := range fs.Scopes {
+			var rs []string
+			for _, v := range sc.Vars {
+				rs = append(rs, ref(v))
+			}
+			scs = append(scs, fmt.Sprintf("scope %d %d %s %s\n", k, sc.Parent, gofvRanges(sc.Ranges), gofvListP(rs)))
+		}
+		for k, c := range fs.InlCalls.Calls {
+			var ch, rs []string
+			for _, i := range c.Children {
+				ch = append(ch, strconv.Itoa(i))
+			}
+			for _, v := range c.InlVars {
+				rs = append(rs, ref(v))
+			}
+			ics = append(ics, fmt.Sprintf("inlcall %d %d %s %s %s %d %s %s\n", k, c.InlIndex, gofvPosFL(c.CallPos),
+				x.dwsym(c.AbsFunSym), gofvListP(ch), gofvBoolP(c.Root), gofvRanges(c.Ranges), gofvListP(rs)))
+		}
+		for k, v := range vs {
+			x.dwvar(d, k, v)
+		}
+		for _, l := range scs {
+			x.body.WriteString(l)
+		}
+		for _, l := range ics {
+			x.body.WriteString(l)
+		}
+		syms := []*obj.LSym{info, loc, ranges, d.lines, absfn}
+		gofvDwarf.Lock()
+		refs := map[*obj.LSym][]gofvDIERef{}
+		var offs []string
+		for _, ds := range syms {
+			if ds != nil {
+				refs[ds] = gofvDwarf.refs[ds]
+				delete(gofvDwarf.refs, ds)
+			}
+		}
+		if absfn != nil {
+			offs = gofvDwarf.offs[absfn]
+			delete(gofvDwarf.offs, absfn)
+		}
+		gofvDwarf.Unlock()
+		for _, ds := range syms {
+			for _, r := range refs[ds] {
+				fmt.Fprintf(&x.body, "dieref %s %d %s %d\n", x.sym(ds), r.ridx, x.sym(r.tgt), r.dclidx)
+			}
+		}
+		if absfn != nil {
+			fmt.Fprintf(&x.body, "dieoff %s %s\n", x.sym(absfn), gofvListP(offs))
+		}
+		for _, ds := range syms {
+			if ds != nil {
+				x.dwdata(ds, refs[ds])
+			}
+		}
+	})
+}
