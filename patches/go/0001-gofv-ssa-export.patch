+// gofv per-pass SSA exporter (fv-compiler-go, docs/contracts/export.md, format gofv-ssa 5.1).
+// Enabled by GOFV_SSA_EXPORT=<dir>. Read-only: it never calls caching accessors, never
+// computes type sizes and never creates symbols, so compilation is unchanged.
+
+package ssa
+
+import (
+	"bytes"
+	"cmd/compile/internal/abi"
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/ir"
+	"cmd/compile/internal/reflectdata"
+	"cmd/compile/internal/rttype"
+	"cmd/compile/internal/staticdata"
+	"cmd/compile/internal/types"
+	"cmd/internal/dwarf"
+	"cmd/internal/obj"
+	"cmd/internal/objabi"
+	"cmd/internal/src"
+	"crypto/sha256"
+	"fmt"
+	"internal/buildcfg"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+type gofvSettings struct {
+	dir    string
+	pkg    *regexp.Regexp
+	fn     *regexp.Regexp
+	gotext bool
+}
+
+var gofvSettingsOnce = sync.OnceValue(func() *gofvSettings {
+	dir := os.Getenv("GOFV_SSA_EXPORT")
+	if dir == "" {
+		return nil
+	}
+	s := &gofvSettings{dir: dir, gotext: os.Getenv("GOFV_SSA_GOTEXT") == "1"}
+	if p := os.Getenv("GOFV_SSA_PKG"); p != "" {
+		s.pkg = regexp.MustCompile(p)
+	}
+	if p := os.Getenv("GOFV_SSA_FUNC"); p != "" {
+		s.fn = regexp.MustCompile(p)
+	}
+	return s
+})
+
+func init() {
+	if os.Getenv("GOFV_SSA_EXPORT") != "" {
+		reflectdata.GOFVTrackTypeInfo()
+	}
+}
+
+// GOFVNoteTypeInfo records that f obtained the type descriptor symbol s
+// (reflectdata.TypeLinksym) for t. Only symbols whose TypeInfo was set while functions were
+// compiled concurrently are recorded, at f's first request: their TypeInfo type is the object
+// of whichever function asked first, while the object f asks for depends on f alone (#426).
+func (f *Func) GOFVNoteTypeInfo(s *obj.LSym, t *types.Type) {
+	if _, ok := f.gofvTypeInfo[s]; ok || !reflectdata.GOFVConcurrentTypeInfo(s) {
+		return
+	}
+	if f.gofvTypeInfo == nil {
+		f.gofvTypeInfo = map[*obj.LSym]*types.Type{}
+	}
+	f.gofvTypeInfo[s] = t
+}
+
+// gofvNoteElemTypeInfo is GOFVNoteTypeInfo for the element type descriptor elem that
+// rewriteFixedLoad obtains from the pointer type descriptor s: the element of s's type as f
+// determines it.
+func (f *Func) gofvNoteElemTypeInfo(elem, s *obj.LSym) {
+	if !reflectdata.GOFVConcurrentTypeInfo(elem) {
+		return
+	}
+	if t, _ := f.gofvTypeInfoOf(s); t != nil && t.IsPtr() {
+		f.GOFVNoteTypeInfo(elem, t.Elem())
+	}
+}
+
+// gofvTypeInfoOf returns the type of s's TypeInfo as f's compilation determines it (nil if s
+// has none): the type f asked for if the TypeInfo was set concurrently (GOFVNoteTypeInfo),
+// else the TypeInfo's, which was set before the concurrent compilation. ok is false if the
+// TypeInfo was set concurrently and f did not ask for s (the type then depends on goroutine
+// order).
+func (f *Func) gofvTypeInfoOf(s *obj.LSym) (t *types.Type, ok bool) {
+	if t, ok := f.gofvTypeInfo[s]; ok {
+		return t, true
+	}
+	ti := s.TypeInfo()
+	if ti == nil {
+		return nil, true
+	}
+	t, _ = ti.Type.(*types.Type)
+	return t, !reflectdata.GOFVConcurrentTypeInfo(s)
+}
+
+// gofvExporter accumulates one function's export file.
+type gofvExporter struct {
+	f    *Func
+	set  *gofvSettings
+	out  bytes.Buffer // the whole file
+	text bytes.Buffer // GOFV_SSA_GOTEXT output
+
+	defs  bytes.Buffer // definitions of the current section
+	body  bytes.Buffer // f/b/v/... lines of the current section
+	warns []string
+
+	types    map[*types.Type]int
+	typeKeys map[string]int // canonical type key -> number
+	typeList []*types.Type
+	typeDefs []*gofvTypeDef // by number - 1
+	aux      map[Aux]int
+	auxTypes map[int]int    // type number -> aux number of *types.Type aux values
+	auxLast  map[int]string // last emitted definition per aux number
+	nAux     int
+	slots    map[*LocalSlot]int
+	posbases map[int32]bool
+	nsec     int
+}
+
+func gofvBegin(f *Func) *gofvExporter {
+	set := gofvSettingsOnce()
+	if set == nil {
+		return nil
+	}
+	pkg := base.Ctxt.Pkgpath
+	if set.pkg != nil && !set.pkg.MatchString(pkg) {
+		return nil
+	}
+	if set.fn != nil && !set.fn.MatchString(pkg+"."+f.Name) {
+		return nil
+	}
+	x := gofvNewExporter(f, set)
+	x.section("start")
+	return x
+}
+
+// gofvNewExporter returns an exporter for f with the file header and config lines written
+// (no section yet). set may carry no directory when the caller does not write files.
+func gofvNewExporter(f *Func, set *gofvSettings) *gofvExporter {
+	pkg := base.Ctxt.Pkgpath
+	gofvMarkAddrConv(f)
+	gofvMarkDeferBits(f)
+	x := &gofvExporter{
+		f:        f,
+		set:      set,
+		types:    map[*types.Type]int{},
+		typeKeys: map[string]int{},
+		aux:      map[Aux]int{},
+		auxTypes: map[int]int{},
+		auxLast:  map[int]string{},
+		slots:    map[*LocalSlot]int{},
+		posbases: map[int32]bool{},
+	}
+	fmt.Fprintf(&x.out, "gofv-ssa 5.1\npkg %s\nfunc %s %d %d %d\n", gofvQuote(pkg), gofvQuote(f.Name),
+		f.ABISelf.Which(), gofvBool(f.NoSplit), gofvBool(f.IsPgoHot))
+	x.config()
+	return x
+}
+
+// gofvAddrConvNames holds the names marked by gofvMarkAddrConv in this compilation.
+var gofvAddrConvNames sync.Map // *ir.Name -> struct{}
+
+// gofvMarkAddrConv marks the names whose address reaches a conversion to an integer in f (the
+// "addrconv" name flag, format 3): backwards from the argument of every Convert to an integer
+// and (format 4) from every pointer-shaped argument a late-expanded call passes at an
+// integer-typed parameter, an implicit conversion (runtime.deferprocStack(d uintptr) gets the
+// _defer temp's LocalAddr directly; integer arguments are not seeds), through the non-memory
+// arguments of every value except Load/Dereference (whose result is memory contents, not an
+// address computed from the argument) to LocalAddr. Calls are included: the runtime returns
+// pointers derived from its arguments (growsliceBuf returns the stack buffer the frontend
+// passes, whose address append then converts to compare with the stack bounds). Every
+// exporter marks its function when it is made (the start section for GOFV_SSA_EXPORT); marks
+// are never removed, so a later export of the same function (the driver's re-exports, after
+// passes deleted conversions) shows the flags of the first.
+func gofvMarkAddrConv(f *Func) {
+	seen := map[*Value]bool{}
+	var work []*Value
+	push := func(v *Value) {
+		if !seen[v] && v.Type != types.TypeMem { // calls' result tuples (IsMemory) are followed
+			seen[v] = true
+			work = append(work, v)
+		}
+	}
+	for _, b := range f.Blocks {
+		for _, v := range b.Values {
+			switch v.Op {
+			case OpConvert:
+				if v.Type.IsInteger() {
+					push(v.Args[0])
+				}
+			case OpStaticLECall, OpTailLECall, OpInterLECall, OpTailLECallInter, OpClosureLECall:
+				// Inputs follow the fixed code pointer (and closure context); memory is last.
+				first := 0
+				switch v.Op {
+				case OpInterLECall, OpTailLECallInter:
+					first = 1
+				case OpClosureLECall:
+					first = 2
+				}
+				call, ok := v.Aux.(*AuxCall)
+				if !ok || call.abiInfo == nil || int64(len(v.Args)-1-first) != call.NArgs() {
+					continue
+				}
+				for i, a := range v.Args[first : len(v.Args)-1] {
+					if call.TypeOfArg(int64(i)).IsInteger() && a.Type.IsPtrShaped() {
+						push(a)
+					}
+				}
+			}
+		}
+	}
+	for len(work) > 0 {
+		v := work[len(work)-1]
+		work = work[:len(work)-1]
+		switch v.Op {
+		case OpLocalAddr:
+			if n, ok := v.Aux.(*ir.Name); ok {
+				gofvAddrConvNames.Store(n, struct{}{})
+			}
+		case OpLoad, OpDereference:
+		default:
+			for _, a := range v.Args {
+				push(a)
+			}
+		}
+	}
+}
+
+// gofvAddrConv reports whether n is marked (gofvMarkAddrConv).
+func gofvAddrConv(n *ir.Name) bool {
+	_, ok := gofvAddrConvNames.Load(n)
+	return ok
+}
+
+// gofvDeferBitsNames holds the names marked by gofvMarkDeferBits in this compilation.
+var gofvDeferBitsNames sync.Map // *ir.Name -> struct{}
+
+// gofvMarkDeferBits marks f's open-coded defer bitmask (the "deferbits" name flag, format 4):
+// ssagen's deferBitsTemp, an addrtaken uint8 autotmp PAUTO kept alive by a VarLive (the
+// opendeferslot closures are kept alive by VarLives too, but are not uint8 and carry their
+// own flag). The runtime reads it at a panic to run the open-coded defers whose bits are set.
+// Marked when the exporter is made and never removed, like gofvMarkAddrConv.
+func gofvMarkDeferBits(f *Func) {
+	for _, b := range f.Blocks {
+		for _, v := range b.Values {
+			if v.Op != OpVarLive {
+				continue
+			}
+			n, ok := v.Aux.(*ir.Name)
+			if ok && n.Class == ir.PAUTO && n.AutoTemp() && n.Addrtaken() && !n.OpenDeferSlot() &&
+				n.Type().Kind() == types.TUINT8 {
+				gofvDeferBitsNames.Store(n, struct{}{})
+			}
+		}
+	}
+}
+
+// gofvDeferBits reports whether n is marked (gofvMarkDeferBits).
+func gofvDeferBits(n *ir.Name) bool {
+	_, ok := gofvDeferBitsNames.Load(n)
+	return ok
+}
+
+func gofvBool(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// gofvQuote writes s as a gofv string token: printable ASCII except '"' and '\' literal,
+// everything else as \xHH.
+func gofvQuote(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := range len(s) {
+		c := s[i]
+		switch {
+		case c == '"' || c == '\\':
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		case c >= 0x20 && c <= 0x7e:
+			b.WriteByte(c)
+		default:
+			fmt.Fprintf(&b, "\\x%02x", c)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func gofvList(xs []string) string {
+	if len(xs) == 0 {
+		return "-"
+	}
+	return strings.Join(xs, ",")
+}
+
+func gofvFlags(names []string, bits []bool) string {
+	var xs []string
+	for i, n := range names {
+		if bits[i] {
+			xs = append(xs, n)
+		}
+	}
+	return gofvList(xs)
+}
+
+func (x *gofvExporter) warn(format string, args ...any) {
+	x.warns = append(x.warns, fmt.Sprintf(format, args...))
+}
