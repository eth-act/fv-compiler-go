/-- The 9 generic block kinds, in Go's order (`BlockKind.Invalid` is `BlockInvalid`). -/
inductive BlockKind where
  | Invalid
  | Plain
  | If
  | Defer
  | Ret
  | RetJmp
  | Exit
  | JumpTable
  | First
  deriving DecidableEq, Inhabited, Repr

namespace BlockKind

/-- Every block kind, in Go's order. -/
def all : Array BlockKind := #[.Invalid, .Plain, .If, .Defer, .Ret, .RetJmp, .Exit, .JumpTable, .First]

/-- `BlockKind.String()`. -/
def name : BlockKind → String
  | .Invalid => "BlockInvalid"
  | .Plain => "Plain"
  | .If => "If"
  | .Defer => "Defer"
  | .Ret => "Ret"
  | .RetJmp => "RetJmp"
  | .Exit => "Exit"
  | .JumpTable => "JumpTable"
  | .First => "First"

/-- Number of control values (`blockData.controls`). -/
def controls : BlockKind → Nat
  | .Invalid => 0
  | .Plain => 0
  | .If => 1
  | .Defer => 1
  | .Ret => 1
  | .RetJmp => 1
  | .Exit => 1
  | .JumpTable => 1
  | .First => 0

/-- `BlockKind.AuxIntType()` (empty if the kind has no AuxInt). -/
def auxIntType : BlockKind → String
  | .Invalid => ""
  | .Plain => ""
  | .If => ""
  | .Defer => ""
  | .Ret => ""
  | .RetJmp => ""
  | .Exit => ""
  | .JumpTable => ""
  | .First => ""

end BlockKind

instance : Hashable BlockKind := ⟨fun k => hash k.ctorIdx⟩
instance : ToString BlockKind := ⟨BlockKind.name⟩

end GoFV.SSA
