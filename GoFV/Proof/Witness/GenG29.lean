"#

/-- The loaded function (`GenG2.load`, as `gen-check`). -/
def stIn : Except String (LocCtx × Array GoFV.Asm.Prog × (ID → Option Nat) × G2In) :=
  GenG2.load fSsa fProg

def lc : LocCtx :=
  match stIn with
  | .ok x => x.1
  | .error _ => { ctx := default, homes := #[], temps := #[] }

def ps : Array GoFV.Asm.Prog :=
  match stIn with
  | .ok x => x.2.1
  | .error _ => #[]

def bs : ID → Option Nat :=
  match stIn with
  | .ok x => x.2.2.1
  | .error _ => fun _ => none

def g : G2In :=
  match stIn with
  | .ok x => x.2.2.2
  | .error _ => { syms := #[], slotOp := fun _ => none, stksize := 0 }

/-- The PC table `checkG29` gives (`b1`, `b5`, `b4`: one entry per value, then the
terminator). -/
def tab : PcTab := [(1, [5, 5, 5, 5, 7, 7, 8, 8, 9]), (5, [10, 11, 12, 12, 12, 13, 14, 14]),
  (4, [15, 15, 16, 16])]

/-- The class table `checkG29` gives. -/
def kt : KTab := (match checkG29 lc ps bs g with
  | .ok (_, k) => k
  | .error _ => [])

def blk5 : Block := (lc.ctx.f.block? 5).getD default

def val (n : ID) : Value := (lc.ctx.f.value? n).getD default

/-- P0's layout: the Prog with ID `n` at `0x10000 + 4n`, a 16-byte frame, every symbol at
`symA`. -/
def L : Link := Link.byId (fun _ => GenG2.symA) GenG2.text 16 8 ps.toList

/-- A framed activation (`SP = 0x7fff0000`, `g = 0x9000`, saved `LR` and `FP` 0) with the globals
at `symA`, `heap 1` at `GenG13.A` and the PC table of `checkG29`. -/
def E : MatchEnv :=
  { lc, ι := GenG13.ι, sp := GenG2.sp0, slot := fun _ => none, g := 0x9000, lr := 0, fp := 0,
    framed := true, pcOf := pcOfTab GenG2.text ps.toList tab }

/-- The second halfword `q.f2`, loaded by `v31`. -/
def hQ : BitVec 16 := 0xbeef

/-- The first halfword `p.f2`, loaded by `v26` and widened by `v21`. -/
def hP : BitVec 32 := 0x1234

/-- The `runLoc` state before `v33`: `hQ` in `R1` (`v31`), `hP` widened to 32 bits in `R2`
(`v21`), every other register `poison`, the memory `GenG13.mem7`. -/
def s0 : LocState :=
  { fr := { regs := Array.replicate 32 none, args := [], mem0 := GenG13.mem7 },
    regs := Array.ofFn (n := 64) fun i =>
      if i.val = 1 then .int .w16 hQ else if i.val = 2 then .int .w32 hP else .poison,
    flags := .poison, slots := [], mem := .mem GenG13.mem7 }

/-- The machine before `v33`: `X1 = 0xbeef` and `X2 = 0x1234`, both zero-extended from 16 bits,
the activation's `g` and `FP`, the PC of `v33`, the memory `GenG13.M7`. -/
def m0 : MState :=
  { x := fun k => if k = 1 then 0xbeef else if k = 2 then 0x1234
      else if k = 28 then 0x9000 else if k = 29 then GenG2.sp0 - 8 else 0,
    sp := GenG2.sp0, v := fun _ => 0, nzcv := ⟨false, false, false, false⟩,
    pc := E.pcOf 5 3, mem := GenG13.M7 }

/-- The register holds the 32-bit integer `0xbeef`. -/
def isQ : Option Val → Bool
  | some (.int .w32 x) => decide (x = 0xbeef)
  | _ => false

theorem isQ_spec {o : Option Val} (h : isQ o = true) : o = some (.int .w32 0xbeef) := by
  unfold isQ at h
  split at h
  · rw [of_decide_eq_true h]
  · cases h

/-- The table before and after `v33`: `R1` (`v31`) and `R2` (`v26`) zero-extended from 16
bits. -/
def tbl : List (Nat × Nat × Bool) := [(1, 16, false), (2, 16, false)]

/-- What compiled evaluation checks on `.eq.M1K1M2`: it holds an arm64 op, `checkG29` accepts it
with `tab` and `kt` and `checkG28` does not; it accesses no frame variable and has no home slot;
`b5` holds `v33` (`MOVDnop v31`) at index 3; `R1` has class 16 and `R2` class 32 before it; G20's
table `uAt` is empty there, G29's `uL` is `tbl` before and after `v33`; `stepLoc` runs `v33` from
`s0` to `R1 = 0xbeef` as a 32-bit integer. -/
def gFacts : Bool :=
  lc.ctx.f.lowered &&
    (checkG29 lc ps bs g).toOption == some (tab, kt) && (checkG28 lc ps bs g).toOption.isNone &&
    (accessedVars lc).isEmpty && (homeSlots lc).isEmpty &&
    lc.ctx.f.blocks.toList.contains 5 && (lc.ctx.f.block? 5).isSome &&
    (lc.ctx.f.value? 33).isSome && blk5.values[3]? == some 33 &&
    (val 33).op == .ARM64MOVDnop && (val 33).args == #[31] &&
    (kAt lc kt 5 blk5 3).get 1 == some 16 && (kAt lc kt 5 blk5 3).get 2 == some 32 &&
    uAt lc blk5 3 == none && uL lc blk5 3 == tbl && uL lc blk5 4 == tbl &&
    GenG1.okThen (stepLoc GenG2.env lc s0 (val 33)) fun s1 => isQ s1.regs[1]?

theorem g29_facts : gFacts = true := by
  native_decide

/-- The facts of `g29_facts` as hypotheses. -/
theorem facts :
    lc.ctx.f.lowered = true ∧ checkG29 lc ps bs g = .ok (tab, kt) ∧
      (accessedVars lc).isEmpty = true ∧ (homeSlots lc).isEmpty = true ∧
      5 ∈ lc.ctx.f.blocks.toList ∧ lc.ctx.f.block? 5 = some blk5 ∧
      lc.ctx.f.value? 33 = some (val 33) ∧ blk5.values[3]? = some 33 ∧
      (val 33).op = .ARM64MOVDnop ∧ (val 33).args = #[31] ∧
      (kAt lc kt 5 blk5 3).get 1 = some 16 ∧ (kAt lc kt 5 blk5 3).get 2 = some 32 ∧
      uAt lc blk5 3 = none ∧ uL lc blk5 3 = tbl ∧ uL lc blk5 4 = tbl ∧
      GenG1.okThen (stepLoc GenG2.env lc s0 (val 33)) (fun s1 => isQ s1.regs[1]?) = true := by
  have hf := g29_facts
  simp only [gFacts, Bool.and_eq_true, beq_iff_eq, List.contains_iff_mem] at hf
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hl, hres⟩, -⟩, hav⟩, hsl⟩, hm5⟩, hb5s⟩, hv33s⟩, hi3⟩, hop⟩, hargs⟩,
    hk1⟩, hk2⟩, hu⟩, hu3⟩, hu4⟩, hrun⟩ := hf
  refine ⟨hl, ?_, hav, hsl, hm5, ?_, ?_, hi3, hop, hargs, hk1, hk2, hu, hu3, hu4, hrun⟩
  · revert hres; cases checkG29 lc ps bs g <;> simp [Except.toOption]
  · obtain ⟨b, hb⟩ := Option.isSome_iff_exists.1 hb5s
    simp [blk5, hb]
  · obtain ⟨v, hv⟩ := Option.isSome_iff_exists.1 hv33s
    simp [val, hv]

theorem g29Env (hc : checkG29 lc ps bs g = .ok (tab, kt)) (hl : lc.ctx.f.lowered = true)
    (hav : (accessedVars lc).isEmpty = true) (hsl : (homeSlots lc).isEmpty = true) :
    G28Env lc g L ps 0 tab E where
  env := {
    env := {
      env := {
        env := {
          lcEq := rfl
          link := rfl
          pcOf := rfl
          retOut := by
            obtain ⟨-, -, -, -, -, -, -, -, -, -, -, hlt, -, -, -, -⟩ := checkG29_spec hl hc
            intro p hp
            exact GenG2.prog_addr_ne (hlt p hp) hp (by simp) (by simp)
          addr := GenG12.addrAgree
          glob := fun _ _ _ _ => rfl
          syms := by
            obtain ⟨-, -, -, -, -, -, -, -, -, -, -, hlt, -, -, -, -⟩ := checkG29_spec hl hc
            intro y
            have hs : L.sym y = GenG2.symA := rfl
            rw [hs]
            refine ⟨by decide, fun p hp => ?_⟩
            exact GenG2.prog_addr_ne (hlt p hp) hp (Or.inr (by decide)) (by decide)
          calls := fun h => by cases h
          slot := fun k hk => by simp [List.isEmpty_iff.1 hsl] at hk
          extra := by decide
          frame := ⟨by decide, by decide, fun k off h => by cases h⟩ }
        vars := by
          intro x hx
          simp [List.isEmpty_iff.1 hav] at hx }
      wbs := fun h => by cases h }
    icalls := fun h => by cases h }
  memeqs := fun h => by cases h

theorem sep0 : SepFrom GenG13.ι (StkAt E) GenG13.mem7 := by
  intro b al a h ha y hy
  obtain ⟨rfl, rfl⟩ := GenG13.mem7_blocks h
  have ha' : a = GenG13.A := by simp [GenG13.ι, GenG12.ι] at ha; exact ha.symm
