"#

/-- P0' (`p0Prime`) and the port's output of `sync/atomic.AddInt32` (as `obj-check`). -/
def objIn : Except String (Array Prog × ObjIn) := do
  let pf ← parseProgFile fProg.toUTF8
  let out ← flush pf
  let ps ← p0Prime (fun n => out.st.symIdx[(GoFV.SSA.GoStr.ofString n, Obj.ABI0.toNat)]?)
    pf.prog0.progs
  return (ps, { text := out.st.textP, relocs := out.st.textR, progs := out.progs })

def ps : Array Prog :=
  match objIn with
  | .ok x => x.1
  | .error _ => #[]

def obj : ObjIn :=
  match objIn with
  | .ok x => x.2
  | .error _ => ⟨ByteArray.empty, #[], #[]⟩

/-- The first Prog with opcode `a`. -/
def progOf (a : As) : Prog := ps[(ps.findIdx? (·.as == a)).getD 0]!

/-- The offset the assembler placed the Prog with ID `id` at. -/
def pcOf (id : Nat) : Nat := ((obj.progs.find? (·.id == id)).map (·.pc.toNat)).getD 0

/-- `checkProg` of `p` (a frameless function: `autosize` and `extrasize` 0; `X27` not related
before it) against its one word. -/
def chk (p : Prog) : Except String Bool :=
  checkProg obj.text obj.relocs.toList [] 0 0 false p (pcOf p.id) (pcOf p.id + 4)

/-- `checkProg` accepts `p` against its one word, returning `b` (whether `X27` is related after
it), and the word decodes to `i`. -/
def okProg (p : Prog) (i : Insn) (b : Bool) : Bool :=
  isOk (chk p) && getOk (chk p) == b && decode (wordAt obj.text (pcOf p.id)) == some i

/-- `LDADDAL W1, W2, [X0]`. -/
def insnAdd : Insn := .atomic 2 true true 1 false 0 0 2
/-- `LDAXR W2, [X0]`. -/
def insnLdx : Insn := .ldstExcl 2 false true true 31 0 2
/-- `STLXR W27, W2, [X0]`. -/
def insnStx : Insn := .ldstExcl 2 false false true 27 0 2
/-- `CASAL W27, W2, [X0]` (the word of `CompareAndSwapInt32`'s `CASALW R27, (R0), R2`). -/
def insnCas : Insn := .cas 2 true true 27 0 2

/-- The effect of `LDADDALW R1, (R0), R2`: the old word to `R2`, old plus `R1` stored. -/
def σAdd : Sym :=
  { x := [(2, .ld 4 (.x 0))], loads := [(.x 0, 4)], stores := [(.x 0, 4, .add (.ld 4 (.x 0)) (.x 1))] }

/-- The effect of `STLXRW R2, (R0), R27`: `R2` stored, the status register `R27` 0. -/
def σStx : Sym := { x := [(27, .k 0)], stores := [(.x 0, 4, .x 2)] }

/-- The effect of `CASALW R27, (R0), R2`: the old word to `R27`; `R2` stored on a match with
`R27`'s low word, else the old word. -/
def σCas : Sym :=
  { x := [(27, .ld 4 (.x 0))], loads := [(.x 0, 4)],
    stores := [(.x 0, 4, .eqsel 4 (.ld 4 (.x 0)) (.x 27) (.x 2) (.ld 4 (.x 0)))] }

/-- `CASALW R27, (R0), R2` as genssa writes it. -/
def casP : Prog :=
  { mkProg 10 .CASALW { type := .REG, reg := REG_R0 + 27 } { type := .MEM, reg := REG_R0 } with
    regTo2 := REG_R0 + 2 }

/-- What compiled evaluation checks: `checkProg` accepts `AddInt32`'s `LDADDALW`, `LDAXRW` and
`STLXRW` against their words (only `STLXRW`, which sets `R27` to `0` on both sides, leaves `X27`
related); `progSym` gives `σAdd`, `σStx`, and `σCas` for `casP`. -/
def atomicFacts : Bool :=
  okProg (progOf .LDADDALW) insnAdd false && okProg (progOf .LDAXRW) insnLdx false &&
    okProg (progOf .STLXRW) insnStx true &&
    (progOf .LDADDALW).as == .LDADDALW && (progOf .LDAXRW).as == .LDAXRW &&
    (progOf .STLXRW).as == .STLXRW &&
    isOk (progSym 0 0 (progOf .LDADDALW)) && getOk (progSym 0 0 (progOf .LDADDALW)) == (σAdd, .fall) &&
    isOk (progSym 0 0 (progOf .STLXRW)) && getOk (progSym 0 0 (progOf .STLXRW)) == (σStx, .fall) &&
    isOk (progSym 0 0 casP) && getOk (progSym 0 0 casP) == (σCas, .fall)

theorem atomic_facts : atomicFacts = true := by
  native_decide

/-- **`checkProg` on `AddInt32`'s atomics**: its `LDADDALW`, `LDAXRW` and `STLXRW` are accepted
against the words the assembler gave them, and only `STLXRW` leaves `X27` related to `R27` (its
status `0` on both sides, `est27`); the Prog side and the word side have the effects `σAdd` and
`σStx`; `CASALW R27, (R0), R2` and its word `CASAL W27, W2, [X0]` have the same effect `σCas`. -/
theorem objAtomic_prog_witness :
    let pA := progOf .LDADDALW
    let pL := progOf .LDAXRW
    let pS := progOf .STLXRW
    pA.as = .LDADDALW ∧ pL.as = .LDAXRW ∧ pS.as = .STLXRW ∧
      checkProg obj.text obj.relocs.toList [] 0 0 false pA (pcOf pA.id) (pcOf pA.id + 4) =
        .ok false ∧
      checkProg obj.text obj.relocs.toList [] 0 0 false pL (pcOf pL.id) (pcOf pL.id + 4) =
        .ok false ∧
      checkProg obj.text obj.relocs.toList [] 0 0 false pS (pcOf pS.id) (pcOf pS.id + 4) =
        .ok true ∧
      decode (wordAt obj.text (pcOf pA.id)) = some insnAdd ∧
      decode (wordAt obj.text (pcOf pL.id)) = some insnLdx ∧
      decode (wordAt obj.text (pcOf pS.id)) = some insnStx ∧
      progSym 0 0 pA = .ok (σAdd, .fall) ∧ symInsn insnAdd (pcOf pA.id) {} = .ok (σAdd, .fall) ∧
      progSym 0 0 pS = .ok (σStx, .fall) ∧ symInsn insnStx (pcOf pS.id) {} = .ok (σStx, .fall) ∧
      progSym 0 0 casP = .ok (σCas, .fall) ∧ symInsn insnCas 16 {} = .ok (σCas, .fall) := by
  have hf := atomic_facts
  simp only [atomicFacts, okProg, Bool.and_eq_true, beq_iff_eq] at hf
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hA, hbA⟩, hdA⟩, ⟨hL, hbL⟩, hdL⟩, ⟨hS, hbS⟩, hdS⟩, haA⟩, haL⟩, haS⟩, hpA⟩,
    hpA'⟩, hpS⟩, hpS'⟩, hpC⟩, hpC'⟩ := hf
  exact ⟨haA, haL, haS, (eq_getOk hA).trans (congrArg _ hbA),
    (eq_getOk hL).trans (congrArg _ hbL), (eq_getOk hS).trans (congrArg _ hbS), hdA, hdL, hdS,
    by rw [eq_getOk hpA, hpA'], rfl, by rw [eq_getOk hpS, hpS'], rfl,
    by rw [eq_getOk hpC, hpC'], rfl⟩

/-! ## The whole function: `X27` across Progs -/

/-- The morestack tail's spills of `AddInt32` (`prog0`'s `fn`, as `obj-check`). -/
def spills : Array Spill :=
  match parseProgFile fProg.toUTF8 with
  | .ok pf => pf.prog0.fn.spills
  | .error _ => #[]

/-- What `checkObj` returns on `AddInt32`. -/
def tab : Tab := getOk (checkObj ps spills obj)

/-- What compiled evaluation checks of the whole function: `checkObj` accepts it, relying on
`X27` (`Tab.ok27`) only at the Prog at index 15, the `CBNZ R27` after the `STLXRW` (whose status
`R27` the words leave in `X27`); the loop head `LDAXRW` (index 12) and the `MOVD` after the loop
(index 16) are branch targets, so `X27` is not relied on there. -/
def wholeFacts : Bool :=
  isOk (checkObj ps spills obj) && tab.ok27.toList == (List.range 19).map (· == 15) &&
    ps.size == 19 && (ps[14]!).as == .STLXRW && (ps[15]!).as == .CBNZ

theorem whole_facts : wholeFacts = true := by
  native_decide

/-- **`checkObj` accepts the whole of `AddInt32`**, its LSE path and its LL/SC fallback loop, and
relies on `X27` (`Tab.ok27`) exactly at the `CBNZ R27`; there `X27At` holds of a P0 state `s` and
a machine state `t` exactly if `t.x 27 = s.x 27` (for a layout `L` whose symbols are not at the
`CBNZ`'s P0 address). -/
theorem objAtomic_whole_witness :
    checkObj ps spills obj = .ok tab ∧ (ps[15]!).as = .CBNZ ∧ tab.ok27[15]? = some true ∧
      (∀ j, j ≠ 15 → tab.ok27[j]? ≠ some true) ∧
      ∀ (L : Link) (s t : MState), (∀ y, L.sym y ≠ s.pc) →
        s.pc = addrP L.text (ps[15]!).id → (X27At tab L ps.toList s t ↔ t.x 27 = s.x 27) := by
  have hf := whole_facts
  simp only [wholeFacts, Bool.and_eq_true, beq_iff_eq] at hf
  obtain ⟨⟨⟨⟨hok, hl⟩, hsz⟩, -⟩, hcb⟩ := hf
  have hok' : tab.ok27[15]? = some true := by
    rw [← Array.getElem?_toList, hl]; decide
  have h15 : 15 < ps.toList.length := by simp [hsz]
  have hp15 : ps.toList[15] = ps[15]! := by simp [getElem!_def, hsz]
  refine ⟨eq_getOk hok, hcb, hok', fun j hj h => hj ?_, fun L s t hsym hpc => ⟨fun hX => ?_, fun h27 => ?_⟩⟩
  · rw [← Array.getElem?_toList, hl] at h
    by_cases hj' : j < 19
    · simp [hj'] at h
      exact h
    · simp [hj'] at h
  · exact hX.at27 15 h15 (by rw [hp15]; exact hpc.symm) hok'
  · exact ⟨fun _ _ _ _ => h27, fun ⟨y, hy⟩ => absurd hy.symm (hsym y)⟩

/-! ## The words, run -/

/-- A state at `0x1000` with `X0 = 0x8000`, `X1 = 5`, `X2 = x2`, `X27 = x27` and the word `37` at
`0x8000`. -/
def st (x2 x27 : BitVec 64) : MState :=
  { x := fun r => if r = 0 then 0x8000 else if r = 1 then 5 else if r = 2 then x2
      else if r = 27 then x27 else 0,
    sp := 0x10000, v := fun _ => 0, nzcv := ⟨false, false, false, false⟩, pc := 0x1000,
    mem := fun a => if a = 0x8000 then 37 else 0 }

/-- `σ`'s accesses are at `X0` (`0x8000`, outside the nil page). -/
private theorem noNil_x0 (x2 x27 : BitVec 64) {σ : Sym} (hl : ∀ q ∈ σ.loads, q.1 = .x 0)
    (hs : ∀ q ∈ σ.stores, q.1 = .x 0) : NoNil ⟨st x2 x27, fun _ => 0⟩ σ := by
  refine ⟨fun a n h => ?_, fun a n v h => ?_⟩
  · have ha : a = .x 0 := hl _ h
    subst ha; show nilPage 0x8000 = false; decide
  · have ha : a = .x 0 := hs _ h
    subst ha; show nilPage 0x8000 = false; decide

/-- `symInsn_sound` of a word at `0x1000` from `st x2 x27`, whose accesses are at `X0`. -/
private theorem run {i : Insn} {σ : Sym} (x2 x27 : BitVec 64) (h : symInsn i 0 {} = .ok (σ, .fall))
    (hl : ∀ q ∈ σ.loads, q.1 = .x 0) (hs : ∀ q ∈ σ.stores, q.1 = .x 0) :
    ∃ t', exec i (st x2 x27) = .ok t' ∧
      WordsPost ⟨st x2 x27, fun _ => 0⟩ 0x1000 0 σ .fall t' :=
  symInsn_sound (c := ⟨st x2 x27, fun _ => 0⟩) (base := 0x1000) h (holds_init _) rfl
    (noNil_x0 x2 x27 hl hs)

/-- **`LDADDAL W1, W2, [X0]`, run** (`symInsn_sound`, `execAtomic`): 5 added to the 37 at
`0x8000`, `W2` the old 37. -/
theorem objAtomic_ldadd_run :
    ∃ t', exec insnAdd (st 0 0) = .ok t' ∧ readMem t'.mem 0x8000 4 = 42 ∧ t'.x 2 = 37 ∧
      t'.pc = 0x1004 := by
  obtain ⟨t', he, hp⟩ := run (i := insnAdd) (σ := σAdd) 0 0 rfl (by simp [σAdd]) (by simp [σAdd])
  refine ⟨t', he, ?_, ?_, ?_⟩
  · rw [hp.1.mem]; decide +kernel
  · rw [show (2 : Reg) = BitVec.ofNat 5 2 from rfl, hp.1.x 2 (by omega)]; decide +kernel
  · rw [hp.2.2]; decide +kernel

/-- **`STLXR W27, W2, [X0]`, run** (`execExcl`): `W2` stored, the status `W27` 0 (one core). -/
theorem objAtomic_stlxr_run :
    ∃ t', exec insnStx (st 9 1) = .ok t' ∧ readMem t'.mem 0x8000 4 = 9 ∧ t'.x 27 = 0 := by
  obtain ⟨t', he, hp⟩ := run (i := insnStx) (σ := σStx) 9 1 rfl (by simp [σStx]) (by simp [σStx])
  refine ⟨t', he, ?_, ?_⟩
  · rw [hp.1.mem]; decide +kernel
  · rw [show (27 : Reg) = BitVec.ofNat 5 27 from rfl, hp.1.x 27 (by omega)]; decide +kernel

/-- **`CASAL W27, W2, [X0]` on a match** (`execCas`): `W27` = 37 = the word at `0x8000`, so `W2`
(9) is stored; `W27` gets the old 37. -/
theorem objAtomic_cas_hit :
    ∃ t', exec insnCas (st 9 37) = .ok t' ∧ readMem t'.mem 0x8000 4 = 9 ∧ t'.x 27 = 37 := by
  obtain ⟨t', he, hp⟩ := run (i := insnCas) (σ := σCas) 9 37 rfl (by simp [σCas]) (by simp [σCas])
  refine ⟨t', he, ?_, ?_⟩
  · rw [hp.1.mem]; decide +kernel
  · rw [show (27 : Reg) = BitVec.ofNat 5 27 from rfl, hp.1.x 27 (by omega)]; decide +kernel

/-- **`CASAL W27, W2, [X0]` on a mismatch**: `W27` = 36, the memory keeps its 37 (the symbolic
store of the old value, `Ex.eqsel`; `writeMem_readMem`); `W27` gets the old 37. -/
theorem objAtomic_cas_miss :
    ∃ t', exec insnCas (st 9 36) = .ok t' ∧ t'.mem = (st 9 36).mem ∧ t'.x 27 = 37 := by
  obtain ⟨t', he, hp⟩ := run (i := insnCas) (σ := σCas) 9 36 rfl (by simp [σCas]) (by simp [σCas])
  refine ⟨t', he, ?_, ?_⟩
  · rw [hp.1.mem]
    have h : ((Ex.eqsel 4 (.ld 4 (.x 0)) (.x 27) (.x 2) (.ld 4 (.x 0))).eval128
        ⟨st 9 36, fun _ => 0⟩).setWidth (8 * 4) = readMem (st 9 36).mem 0x8000 4 := by
      decide +kernel
    show writeMem (st 9 36).mem 0x8000 4 _ = _
    rw [h]
    exact writeMem_readMem 4 _ _
  · rw [show (27 : Reg) = BitVec.ofNat 5 27 from rfl, hp.1.x 27 (by omega)]; decide +kernel

/-- `Ex.eval_rmwEx` on `σAdd`'s stored value: 37 + 5. -/
theorem objAtomic_rmwEx :
    (rmwEx false 0 (.ld 4 (.x 0)) (.x 1)).eval ⟨st 0 0, fun _ => 0⟩ = 42 := by
  rw [Ex.eval_rmwEx]; decide +kernel

end GoFV.Proof.Witness.ObjAtomic
