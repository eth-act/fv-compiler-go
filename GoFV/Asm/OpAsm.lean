namespace ARM64

/-- `condBits` (arm64/ssa.go:1942): the condition (`SpecialOperand`) of a flag predicate op. -/
def condBits : Op → Option Int
  | .ARM64Equal => some SPOP_EQ
  | .ARM64NotEqual => some SPOP_NE
  | .ARM64LessThan => some SPOP_LT
  | .ARM64LessThanU => some SPOP_LO
  | .ARM64LessEqual => some SPOP_LE
  | .ARM64LessEqualU => some SPOP_LS
  | .ARM64GreaterThan => some SPOP_GT
  | .ARM64GreaterThanU => some SPOP_HI
  | .ARM64GreaterEqual => some SPOP_GE
  | .ARM64GreaterEqualU => some SPOP_HS
  | .ARM64LessThanF => some SPOP_MI
  | .ARM64LessEqualF => some SPOP_LS
  | .ARM64GreaterThanF => some SPOP_GT
  | .ARM64GreaterEqualF => some SPOP_GE
  | .ARM64NotLessThanF => some SPOP_PL
  | .ARM64NotLessEqualF => some SPOP_HI
  | .ARM64NotGreaterThanF => some SPOP_LE
  | .ARM64NotGreaterEqualF => some SPOP_LT
  | .ARM64LessThanNoov => some SPOP_MI
  | .ARM64GreaterEqualNoov => some SPOP_PL
  | _ => none

/-- `blockJump` (arm64/ssa.go:1968): `(asm, invasm)` of a conditional block kind. -/
def blockJump : BlockKind → Option (As × As)
  | .ARM64EQ => some (.BEQ, .BNE)
  | .ARM64NE => some (.BNE, .BEQ)
  | .ARM64LT => some (.BLT, .BGE)
  | .ARM64GE => some (.BGE, .BLT)
  | .ARM64LE => some (.BLE, .BGT)
  | .ARM64GT => some (.BGT, .BLE)
  | .ARM64ULT => some (.BLO, .BHS)
  | .ARM64UGE => some (.BHS, .BLO)
  | .ARM64UGT => some (.BHI, .BLS)
  | .ARM64ULE => some (.BLS, .BHI)
  | .ARM64Z => some (.CBZ, .CBNZ)
  | .ARM64NZ => some (.CBNZ, .CBZ)
  | .ARM64ZW => some (.CBZW, .CBNZW)
  | .ARM64NZW => some (.CBNZW, .CBZW)
  | .ARM64TBZ => some (.TBZ, .TBNZ)
  | .ARM64TBNZ => some (.TBNZ, .TBZ)
  | .ARM64FLT => some (.BMI, .BPL)
  | .ARM64FGE => some (.BGE, .BLT)
  | .ARM64FLE => some (.BLS, .BHI)
  | .ARM64FGT => some (.BGT, .BLE)
  | .ARM64LTnoov => some (.BMI, .BPL)
  | .ARM64GEnoov => some (.BPL, .BMI)
  | _ => none

/-- `leJumps` (arm64/ssa.go:1996): `LEnoov` branches, `[next == b.Succs[i]][j]` = `(Jump, Index)`. -/
def leJumps : Array (Array (As × Nat)) := #[#[(.BEQ, 0), (.BPL, 1)], #[(.BMI, 0), (.BEQ, 0)]]

/-- `gtJumps` (arm64/ssa.go:2002): `GTnoov` branches, `[next == b.Succs[i]][j]` = `(Jump, Index)`. -/
def gtJumps : Array (Array (As × Nat)) := #[#[(.BMI, 1), (.BEQ, 1)], #[(.BEQ, 1), (.BPL, 0)]]

/-! Spot values. -/

example : condBits .ARM64Equal = some SPOP_EQ := rfl
example : condBits .ARM64LessThanF = some SPOP_MI := rfl
example : condBits .ARM64ADD = none := rfl
example : blockJump .ARM64ULT = some (.BLO, .BHS) := rfl
example : blockJump .ARM64Z = some (.CBZ, .CBNZ) := rfl
example : blockJump .Plain = none := rfl
example : leJumps[0]![1]! = (.BPL, 1) := rfl
example : gtJumps[1]![1]! = (.BPL, 0) := rfl

end ARM64

