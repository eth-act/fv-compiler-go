/-- The per-value premises of `v33`, `MOVDnop`: none apply. -/
theorem pre33 {s : LocState} (hop : (val 33).op = .ARM64MOVDnop) : G14Pre lc s (val 33) := by
  have hne : ∀ o : Op, o ≠ .ARM64MOVDnop → (val 33).op ≠ o := fun o h h' =>
    h (h'.symm.trans hop)
  refine ⟨⟨⟨⟨⟨?_, ?_, ?_⟩, ?_⟩, ?_⟩, ?_⟩, ?_⟩
  · intro h; rcases h with h | h <;> exact absurd h (hne _ (by decide))
  · intro _ _ _ hl; rw [hop] at hl; cases hl
  · intro h; exact absurd h (hne _ (by decide))
  · intro h; exact absurd h (hne _ (by decide))
  · intro h; exact absurd h (hne _ (by decide))
  · intro h; exact absurd h (hne _ (by decide))
  · intro _ _ _ _ hl; rw [hop] at hl; cases hl

/-- **G29 on `.eq.M1K1M2`**: from the state before `v33` with the halfword `0xbeef` in `R1` and
`0x1234` in `R2`, on a machine whose `X1` and `X2` are zero-extended from 16 bits (the table `uL`
before `v33`, where G20's `uAt` knows nothing), `g29_value` runs `MOVDnop` (`v33`, no code):
`runLoc`'s `R1` holds the 32-bit integer `0xbeef`, the machine state, related to it before `v30`
under an activation extending `E` that is again a `G28Env`, keeps the table, and so the whole
`X1` is `0xbeef` (`LocMatch` alone gives only its low 32 bits). -/
theorem genG29_value_witness :
    ∃ s1 E1 m1, stepLoc GenG2.env lc s0 (val 33) = .ok s1 ∧
      s1.regs[1]? = some (.int .w32 0xbeef) ∧ uAt lc blk5 3 = none ∧
      E.Extends E1 ∧ G28Env lc g L ps 0 tab E1 ∧ PStar GenG2.H0 L ps.toList 0 m0 m1 ∧
      LocMatch E1 s1 5 4 m1 ∧ UOKL m1 (uL lc blk5 4) ∧ m1.x 1 = 0xbeef := by
  obtain ⟨hl, hc, hav, hsl, hm5, hb, hv33, hi3, hop, -, hk1, hk2, hu, hu3, hu4, hrun⟩ := facts
  obtain ⟨s1, hs1, hr1⟩ := GenG1.okThen_spec hrun
  have hr1' := isQ_spec hr1
  have hE := g29Env hc hl hav hsl
  have hne : ∀ o : Op, o ≠ .ARM64MOVDnop → (val 33).op ≠ o := fun o h h' =>
    h (h'.symm.trans hop)
  obtain ⟨E1, m1, hx1, hE1, hp1, hm1', -, hu1⟩ := g29_value (H := GenG2.H0) (env := GenG2.env)
    hc hE hm5 hb hi3 hv33 (by rw [hop]; rfl) locMatch0 (g29Inv0 hk1 hk2) (by rw [hu3]; exact uokl0)
    (pre33 hop)
    (fun h => absurd h (hne _ (by decide))) (fun h => absurd h (hne _ (by decide)))
    (GenG10.icallOK_ne (by rw [hop]; rfl))
    (fun h => absurd h (hne _ (by decide))) (fun h => absurd h (hne _ (by decide)))
    (fun h => absurd h (hne _ (by decide))) (fun h => absurd h (hne _ (by decide)))
    (fun h => absurd h (hne _ (by decide))) hs1
  have hext : ExtOK (m1.x 1) 16 false := by
    have h := hu1
    rw [hu4] at h
    exact h (1, 16, false) (by simp [tbl]) 1 (by decide) rfl
  have hlo : (m1.x 1).setWidth 32 = 0xbeef := (hm1'.regs 1 _ hr1').1 1 rfl
  have hlo16 : (m1.x 1).setWidth 16 = 0xbeef := by
    rw [← BitVec.setWidth_setWidth_of_le (m1.x 1) (by decide : 16 ≤ 32), hlo]
    decide
  have hx : m1.x 1 = 0xbeef := by
    simp only [ExtOK, Bool.false_eq_true, ↓reduceIte] at hext
    rw [hext, hlo16]
    decide
  exact ⟨s1, E1, m1, hs1, hr1', hu, hx1, hE1, hp1, hm1', hu1, hx⟩

end GoFV.Proof.Witness.GenG29
