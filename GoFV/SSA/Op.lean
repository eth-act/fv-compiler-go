  | ARM64GEnoov
  | ARM64JUMPTABLE
  | Plain
  | If
  | Defer
  | Ret
  | RetJmp
  | Exit
  | JumpTable
  | First
  deriving DecidableEq, Inhabited, Repr

namespace BlockKind

/-- Every block kind, in Go's order. -/
def all : Array BlockKind := #[.Invalid, .ARM64EQ, .ARM64NE, .ARM64LT, .ARM64LE, .ARM64GT, .ARM64GE, .ARM64ULT, .ARM64ULE, .ARM64UGT, .ARM64UGE, .ARM64Z, .ARM64NZ, .ARM64ZW, .ARM64NZW, .ARM64TBZ, .ARM64TBNZ, .ARM64FLT, .ARM64FLE, .ARM64FGT, .ARM64FGE, .ARM64LTnoov, .ARM64LEnoov, .ARM64GTnoov, .ARM64GEnoov, .ARM64JUMPTABLE, .Plain, .If, .Defer, .Ret, .RetJmp, .Exit, .JumpTable, .First]

