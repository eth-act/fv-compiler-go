  | .ARM64TBZ => "Int64"
  | .ARM64TBNZ => "Int64"
  | .ARM64JUMPTABLE => "Sym"
  | _ => ""

/-- The kind's name in the gofv export: arch prefix and name (`ARM64EQ`; generic: `name`). -/
def exportName (k : BlockKind) : String := k.archName ++ k.name

/-- The Go constant's value (`BlockKind(o)` in the pinned opGen.go; other archs and the SIMD
entries make it differ from `ctorIdx`). -/
def goNum (o : BlockKind) : Nat :=
  let i := o.ctorIdx
  if i < 1 then i + 0 else
  if i < 26 then i + 47 else
  i + 109

/-- Inverse of `goNum`: the exported BlockKind with Go value `n`, if any. -/
def ofGoNum? (n : Nat) : Option BlockKind :=
  if 0 ≤ n ∧ n < 1 then all[n - 0]? else
  if 48 ≤ n ∧ n < 73 then all[n - 47]? else
  if 135 ≤ n ∧ n < 143 then all[n - 109]? else
  none

end BlockKind

instance : Hashable BlockKind := ⟨fun k => hash k.ctorIdx⟩
instance : ToString BlockKind := ⟨BlockKind.name⟩

