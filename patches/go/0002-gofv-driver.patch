+// gofvBackFirstDiff describes the first line where the result and the rendering differ.
+func gofvBackFirstDiff(got, want string) string {
+	a := strings.Split(got, "\n")
+	b := strings.Split(want, "\n")
+	for i := range max(len(a), len(b)) {
+		var la, lb string
+		if i < len(a) {
+			la = a[i]
+		}
+		if i < len(b) {
+			lb = b[i]
+		}
+		if la != lb {
+			return fmt.Sprintf("line %d: result %q, compiler %q", i+2, firstWords(la), firstWords(lb))
+		}
+	}
+	return "no difference"
+}
