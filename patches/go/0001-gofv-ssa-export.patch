+// gofv per-pass SSA exporter (fv-compiler-go, docs/contracts/export.md, format gofv-ssa 1).
+// Enabled by GOFV_SSA_EXPORT=<dir>. Read-only: it never calls caching accessors, never
+// computes type sizes and never creates symbols, so compilation is unchanged.
+
+package ssa
+
+import (
+	"bytes"
+	"cmd/compile/internal/abi"
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/ir"
+	"cmd/compile/internal/reflectdata"
+	"cmd/compile/internal/rttype"
+	"cmd/compile/internal/staticdata"
+	"cmd/compile/internal/types"
+	"cmd/internal/obj"
+	"cmd/internal/objabi"
+	"cmd/internal/src"
+	"crypto/sha256"
+	"fmt"
+	"internal/buildcfg"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+type gofvSettings struct {
+	dir    string
+	pkg    *regexp.Regexp
+	fn     *regexp.Regexp
+	gotext bool
+}
+
+var gofvSettingsOnce = sync.OnceValue(func() *gofvSettings {
+	dir := os.Getenv("GOFV_SSA_EXPORT")
+	if dir == "" {
+		return nil
+	}
+	s := &gofvSettings{dir: dir, gotext: os.Getenv("GOFV_SSA_GOTEXT") == "1"}
+	if p := os.Getenv("GOFV_SSA_PKG"); p != "" {
+		s.pkg = regexp.MustCompile(p)
+	}
+	if p := os.Getenv("GOFV_SSA_FUNC"); p != "" {
+		s.fn = regexp.MustCompile(p)
+	}
+	return s
+})
+
+// gofvExporter accumulates one function's export file.
+type gofvExporter struct {
+	f    *Func
+	set  *gofvSettings
+	out  bytes.Buffer // the whole file
+	text bytes.Buffer // GOFV_SSA_GOTEXT output
+
+	defs  bytes.Buffer // definitions of the current section
+	body  bytes.Buffer // f/b/v/... lines of the current section
+	warns []string
+
+	types    map[*types.Type]int
+	typeKeys map[string]int // canonical type key -> number
+	typeList []*types.Type
+	typeDefs []*gofvTypeDef // by number - 1
+	aux      map[Aux]int
+	auxTypes map[int]int    // type number -> aux number of *types.Type aux values
+	auxLast  map[int]string // last emitted definition per aux number
+	nAux     int
+	slots    map[*LocalSlot]int
+	posbases map[int32]bool
+	nsec     int
+}
+
+func gofvBegin(f *Func) *gofvExporter {
+	set := gofvSettingsOnce()
+	if set == nil {
+		return nil
+	}
+	pkg := base.Ctxt.Pkgpath
+	if set.pkg != nil && !set.pkg.MatchString(pkg) {
+		return nil
+	}
+	if set.fn != nil && !set.fn.MatchString(pkg+"."+f.Name) {
+		return nil
+	}
+	x := gofvNewExporter(f, set)
+	x.section("start")
+	return x
+}
+
+// gofvNewExporter returns an exporter for f with the file header and config lines written
+// (no section yet). set may carry no directory when the caller does not write files.
+func gofvNewExporter(f *Func, set *gofvSettings) *gofvExporter {
+	pkg := base.Ctxt.Pkgpath
+	x := &gofvExporter{
+		f:        f,
+		set:      set,
+		types:    map[*types.Type]int{},
+		typeKeys: map[string]int{},
+		aux:      map[Aux]int{},
+		auxTypes: map[int]int{},
+		auxLast:  map[int]string{},
+		slots:    map[*LocalSlot]int{},
+		posbases: map[int32]bool{},
+	}
+	fmt.Fprintf(&x.out, "gofv-ssa 2\npkg %s\nfunc %s %d %d %d\n", gofvQuote(pkg), gofvQuote(f.Name),
+		f.ABISelf.Which(), gofvBool(f.NoSplit), gofvBool(f.IsPgoHot))
+	x.config()
+	return x
+}
+
+func gofvBool(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+// gofvQuote writes s as a gofv string token: printable ASCII except '"' and '\' literal,
+// everything else as \xHH.
+func gofvQuote(s string) string {
+	var b strings.Builder
+	b.WriteByte('"')
+	for i := range len(s) {
+		c := s[i]
+		switch {
+		case c == '"' || c == '\\':
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		case c >= 0x20 && c <= 0x7e:
+			b.WriteByte(c)
+		default:
+			fmt.Fprintf(&b, "\\x%02x", c)
+		}
+	}
+	b.WriteByte('"')
+	return b.String()
+}
+
+func gofvList(xs []string) string {
+	if len(xs) == 0 {
+		return "-"
+	}
+	return strings.Join(xs, ",")
+}
+
+func gofvFlags(names []string, bits []bool) string {
+	var xs []string
+	for i, n := range names {
+		if bits[i] {
+			xs = append(xs, n)
+		}
+	}
+	return gofvList(xs)
+}
+
+func (x *gofvExporter) warn(format string, args ...any) {
+	x.warns = append(x.warns, fmt.Sprintf(format, args...))
+}
+
+func (x *gofvExporter) config() {
+	f := x.f
+	c := f.Config
+	kv := func(k string, v any) { fmt.Fprintf(&x.out, "config %s %v\n", k, v) }
+	kv("arch", c.arch)
+	kv("goos", buildcfg.GOOS)
+	kv("ptrsize", c.PtrSize)
+	kv("regsize", c.RegSize)
+	kv("bigendian", gofvBool(c.BigEndian))
+	kv("unalignedok", gofvBool(c.unalignedOK))
+	kv("havecondselect", gofvBool(c.haveCondSelect))
+	kv("havebswap64", gofvBool(c.haveBswap64))
+	kv("havebswap32", gofvBool(c.haveBswap32))
+	kv("havebswap16", gofvBool(c.haveBswap16))
+	kv("hasgreg", gofvBool(c.hasGReg))
+	kv("softfloat", gofvBool(c.SoftFloat))
+	kv("race", gofvBool(c.Race))
+	kv("optimize", gofvBool(c.optimize))
+	kv("fixedframesize", c.ctxt.Arch.FixedFrameSize)
+	kv("archalign", c.ctxt.Arch.Alignment)
+	kv("flagshared", gofvBool(c.ctxt.Flag_shared))
+	kv("flagdynlink", gofvBool(c.ctxt.Flag_dynlink))
+	kv("usewb", gofvBool(f.fe.UseWriteBarrier()))
+	kv("debugnil", gofvBool(f.fe.Debug_checknil()))
+	kv("checkenabled", gofvBool(checkEnabled))
+	kv("localpkg", gofvQuote(types.LocalPkg.Path))
+	kv("exp.cgocheck2", gofvBool(buildcfg.Experiment.CgoCheck2))
+	kv("exp.preemptibleloops", gofvBool(buildcfg.Experiment.PreemptibleLoops))
+	kv("exp.simd", gofvBool(buildcfg.Experiment.SIMD))
+	abiConf := func(a interface {
+		GOFVRegAmounts() (int, int)
+		LocalsOffset() int64
+	}) string {
+		i, fl := a.GOFVRegAmounts()
+		return fmt.Sprintf("%d:%d:%d", i, fl, a.LocalsOffset())
+	}
+	kv("abi0", abiConf(c.ABI0))
+	kv("abi1", abiConf(c.ABI1))
+	kv("abiself", int(f.ABISelf.Which()))
+	kv("abidefault", int(f.ABIDefault.Which()))
+	for _, n := range []string{"writeBarrier", "wbZero", "wbMove", "cgoCheckPtrWrite", "cgoCheckMemmove", "goschedguarded"} {
+		s := f.fe.Syslook(n)
+		name := ""
+		if s != nil {
+			name = s.Name
+		}
+		kv("syslook."+n, gofvQuote(name))
+	}
+	zb := ""
+	if ir.Syms.Zerobase != nil {
+		zb = ir.Syms.Zerobase.Name
+	}
+	kv("zerobase", gofvQuote(zb))
+	rtField := func(t *types.Type, off int64) string {
+		return fmt.Sprintf("%d:%s:%d", off, t.Kind().String(), t.Size())
+	}
+	for _, fld := range rttype.Type.Fields() {
+		switch fld.Sym.Name {
+		case "Size_", "PtrBytes", "Hash", "Kind_", "GCData":
+			kv("rttype."+fld.Sym.Name, rtField(fld.Type, fld.Offset))
+		}
+	}
+	for _, fld := range rttype.PtrType.Fields() {
+		if fld.Sym.Name == "Elem" {
+			kv("rttype.PtrType.Elem", rtField(fld.Type, rttype.PtrType.OffsetOf("Elem")))
+		}
+	}
+}
+
+// pos renders an XPos and makes sure its base is defined.
+func (x *gofvExporter) pos(p src.XPos) string {
+	idx := p.FileIndex()
+	if idx != 0 && !x.posbases[idx] {
+		x.posbases[idx] = true
+		b := x.f.Config.ctxt.PosTable.Pos(p).Base()
+		if b == nil {
+			fmt.Fprintf(&x.defs, "posbase p%d \"\" 0 0 -1\n", idx)
+		} else {
+			fmt.Fprintf(&x.defs, "posbase p%d %s %d %d %d\n", idx, gofvQuote(b.AbsFilename()), b.Line(), b.Col(), b.InliningIndex())
+		}
+	}
+	// Raw lico fields: IsStmt() reports PosNotStmt for lico 0, whose stmt bits are 0
+	// (and WithIsStmt leaves lico 0 unchanged, which identifies it).
+	stmt := p.IsStmt()
+	if p.WithIsStmt().IsStmt() == src.PosNotStmt {
+		stmt = 0
+	}
+	return fmt.Sprintf("p%d:%d:%d:%d:%d", idx, p.Line(), p.Col(), stmt, p.Xlogue())
+}
+
+// gofvDeepKnown reports whether the sizes of t and of every type stored inline in t
+// (array elements, struct fields) are calculated, so that typebits.Set (GC masks) does not
+// call CalcSize (which is a fatal error in the backend).
+func gofvDeepKnown(t *types.Type) bool {
+	if !t.GOFVSizeKnown() {
+		return false
+	}
+	switch t.Kind() {
+	case types.TSSA, types.TTUPLE, types.TRESULTS:
+		return false
+	case types.TARRAY:
+		return gofvDeepKnown(t.Elem())
+	case types.TSTRUCT:
+		for _, f := range t.Fields() {
+			if !gofvDeepKnown(f.Type) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func gofvTry[T any](fn func() T) (r T, ok bool) {
+	defer func() {
+		if recover() != nil {
+			ok = false
+		}
+	}()
+	return fn(), true
+}
+
+// typ returns the reference of t, defining it (and what it references) when new.
+func (x *gofvExporter) typ(t *types.Type) string {
+	if t == nil {
+		return "-"
+	}
+	if n, ok := x.types[t]; ok {
+		return fmt.Sprintf("t%d", n)
+	}
+	key := x.typeKey(t)
+	if n, ok := x.typeKeys[key]; ok {
+		x.types[t] = n
+		// Prefer an object whose size the compiler calculated: the definition is
+		// rendered from the representative when the file is finished.
+		if d := x.typeDefs[n-1]; !d.rep.GOFVSizeKnown() && t.GOFVSizeKnown() {
+			d.rep = t
+		}
+		return fmt.Sprintf("t%d", n)
+	}
+	n := len(x.typeList) + 1
+	x.types[t] = n
+	x.typeKeys[key] = n
+	x.typeList = append(x.typeList, t)
+	d := &gofvTypeDef{rep: t}
+	x.typeDefs = append(x.typeDefs, d)
+
+	switch t.Kind() {
+	case types.TPTR, types.TSLICE:
+		d.tail = append(d.tail, x.typ(t.Elem()))
+	case types.TARRAY:
+		d.tail = append(d.tail, x.typ(t.Elem()), strconv.FormatInt(t.NumElem(), 10))
+	case types.TSTRUCT:
+		d.tail = append(d.tail, strconv.Itoa(len(t.Fields())))
+	case types.TFUNC:
+		d.tail = append(d.tail, strconv.Itoa(len(t.Recvs())), strconv.Itoa(len(t.Params())), strconv.Itoa(len(t.Results())))
+	case types.TTUPLE:
+		d.tail = append(d.tail, x.typ(t.FieldType(0)), x.typ(t.FieldType(1)))
+	case types.TRESULTS:
+		nr := t.NumFields()
+		rs := make([]string, nr)
+		for i := range nr {
+			rs[i] = x.typ(t.FieldType(i))
+		}
+		d.tail = append(d.tail, strconv.Itoa(nr), gofvList(rs))
+	}
+	for _, fl := range gofvTypeFields(t) {
+		d.fieldTypes = append(d.fieldTypes, x.typ(fl.Type))
+	}
+	// The definition is rendered at the end (resolveTypes), from the best object of
+	// this identity met in the whole file; references are fixed now.
+	fmt.Fprintf(&x.defs, "\x00T%d\n", n)
+	return fmt.Sprintf("t%d", n)
+}
+
+// gofvTypeDef is a type definition whose text is rendered when the file is finished.
+type gofvTypeDef struct {
+	rep        *types.Type // the object rendered: the first one met, or one with a known size
+	tail       []string    // kind-specific references (fixed at first sight)
+	fieldTypes []string    // references of the field types
+}
+
+// gofvTypeFields returns the field lines' fields of t: struct fields, or a function's
+// receiver, parameters and results.
+func gofvTypeFields(t *types.Type) []*types.Field {
+	switch t.Kind() {
+	case types.TSTRUCT:
+		return t.Fields()
+	case types.TFUNC:
+		return slices.Concat(t.Recvs(), t.Params(), t.Results())
+	}
+	return nil
+}
+
+// renderType renders the definition of type number n.
+func (x *gofvExporter) renderType(n int) string {
+	d := x.typeDefs[n-1]
+	t := d.rep
+	k := t.Kind()
+	special := k == types.TSSA || k == types.TTUPLE || k == types.TRESULTS
+	known := t.GOFVSizeKnown()
+	// AlgType and PtrDataSize call CalcSize(t), which is fatal for an uncalculated t.
+	deep := !special && known
+	size, align, ptrdata := "?", "?", "?"
+	if known {
+		size = strconv.FormatInt(t.Size(), 10)
+		align = strconv.FormatInt(t.Alignment(), 10)
+	}
+	if deep {
+		ptrdata = strconv.FormatInt(types.PtrDataSize(t), 10)
+	}
+	has := func(fn func() bool) bool {
+		return deep && fn()
+	}
+	flags := gofvFlags(
+		[]string{"hasptr", "notinheap", "noalg", "shape", "direct", "comparable", "named", "emptyiface", "variadic"},
+		[]bool{
+			has(t.HasPointers),
+			t.NotInHeap(),
+			t.Noalg(),
+			t.IsShape(),
+			has(func() bool { return types.IsDirectIface(t) }),
+			has(func() bool { return types.IsComparable(t) }),
+			t.Sym() != nil,
+			k == types.TINTER && t.IsEmptyInterface(),
+			k == types.TFUNC && t.IsVariadic(),
+		})
+	symName := ""
+	if deep {
+		symName = types.TypeSymName(t)
+	}
+	str, _ := gofvTry(t.String)
+	var b strings.Builder
+	fmt.Fprintf(&b, "type t%d %s %s %s %s %s %s %s", n, k.String(), size, align, ptrdata, flags, gofvQuote(str), gofvQuote(symName))
+	for _, s := range d.tail {
+		b.WriteString(" " + s)
+	}
+	b.WriteByte('\n')
+	for i, fl := range gofvTypeFields(t) {
+		name := ""
+		if fl.Sym != nil {
+			name = fl.Sym.Name
+		}
+		off := "?"
+		if known && fl.Offset != types.BADWIDTH {
+			off = strconv.FormatInt(fl.Offset, 10)
+		}
+		fmt.Fprintf(&b, "field %d %s %s %s %d\n", i, gofvQuote(name), d.fieldTypes[i], off, gofvBool(fl.Embedded != 0))
+	}
+	return b.String()
+}
+
+// resolveTypes replaces the type definition placeholders in x.out by their text.
+func (x *gofvExporter) resolveTypes() {
+	src := x.out.Bytes()
+	var out bytes.Buffer
+	out.Grow(len(src) + len(src)/8)
+	for len(src) > 0 {
+		i := bytes.IndexByte(src, 0)
+		if i < 0 {
+			out.Write(src)
+			break
+		}
+		out.Write(src[:i])
+		end := bytes.IndexByte(src[i:], '\n')
+		n, err := strconv.Atoi(string(src[i+2 : i+end]))
+		if err != nil {
+			base.Fatalf("gofv export: bad type placeholder")
+		}
+		out.WriteString(x.renderType(n))
+		src = src[i+end+1:]
+	}
+	x.out = out
+}
+
+// typeKey identifies t up to type identity and spelling. The compiler sometimes creates
+// several identical *types.Type objects (e.g. two [2]int) and which one a value ends up
+// with depends on concurrent compilation of other functions, so types are not numbered by
+// pointer but by LinkString (unique per identical type, including local types), the
+// flags that make otherwise identical types behave differently, and String(), which
+// keeps the deterministic distinct objects apart that passes do tell apart by pointer
+// (zcse keys on the type pointer: byte vs uint8, *byte vs *uint8, any vs interface {}).
+// SSA pseudo-types are singletons; tuples and results are keyed by their components.
+func (x *gofvExporter) typeKey(t *types.Type) string {
+	switch t.Kind() {
+	case types.TSSA:
+		return "SSA:" + t.String()
+	case types.TTUPLE:
+		return "TUPLE:" + x.typ(t.FieldType(0)) + "," + x.typ(t.FieldType(1))
+	case types.TRESULTS:
+		nr := t.NumFields()
+		rs := make([]string, nr)
+		for i := range nr {
+			rs[i] = x.typ(t.FieldType(i))
+		}
+		return "RESULTS:" + strings.Join(rs, ",")
+	}
+	ls, ok := gofvTry(t.LinkString)
+	if !ok {
+		ls = fmt.Sprintf("%p", t)
+	}
+	str, _ := gofvTry(t.String)
+	return fmt.Sprintf("%s:%s:%d%d%d:%s", t.Kind(), ls, gofvBool(t.NotInHeap()), gofvBool(t.Noalg()), gofvBool(t.IsShape()), str)
+}
+
+// auxRef returns the reference of an aux value, (re)defining it when new or changed.
+func (x *gofvExporter) auxRef(a Aux) string {
+	if a == nil {
+		return "-"
+	}
+	if t, isType := a.(*types.Type); isType {
+		// Type aux values are numbered by type identity, like types, and are
+		// immutable: defined once, by the first object of that identity seen
+		// (identical types can differ in spelling, e.g. byte and uint8).
+		tn := x.types[t]
+		if tn == 0 {
+			x.typ(t)
+			tn = x.types[t]
+		}
+		if m, seen := x.auxTypes[tn]; seen {
+			return fmt.Sprintf("a%d", m)
+		}
+		n := x.nextAux()
+		x.auxTypes[tn] = n
+		def := x.auxDef(n, a)
+		x.auxLast[n] = def
+		x.defs.WriteString(def)
+		return fmt.Sprintf("a%d", n)
+	}
+	n, ok := x.aux[a]
+	if !ok {
+		n = x.nextAux()
+		x.aux[a] = n
+	}
+	def := x.auxDef(n, a)
+	if x.auxLast[n] != def {
+		x.auxLast[n] = def
+		x.defs.WriteString(def)
+	}
+	return fmt.Sprintf("a%d", n)
+}
+
+func (x *gofvExporter) nextAux() int {
+	x.nAux++
+	return x.nAux
+}
+
+func (x *gofvExporter) auxDef(n int, a Aux) string {
+	var b strings.Builder
+	render, _ := gofvTry(func() string { return fmt.Sprint(a) })
+	fmt.Fprintf(&b, "aux a%d ", n)
+	switch a := a.(type) {
+	case *ir.Name:
+		sym := ""
+		if a.Sym() != nil {
+			sym = a.Sym().Name
+		}
+		flags := gofvFlags(
+			[]string{"addrtaken", "used", "autotmp", "nonmergeable", "opendeferslot", "readonly"},
+			[]bool{a.Addrtaken(), a.Used(), a.AutoTemp(), a.NonMergeable(), a.OpenDeferSlot(), a.Readonly()})
+		fmt.Fprintf(&b, "name %s %s %s %s %d %d %s %s\n", gofvQuote(render), gofvQuote(sym), a.Class.String(),
+			x.typ(a.Type()), a.FrameOffset(), a.Esc(), flags, x.pos(a.Pos()))
+	case *obj.LSym:
+		x.symDef(&b, a, render)
+	case stringAux:
+		fmt.Fprintf(&b, "str %s %s %s\n", gofvQuote(render), gofvQuote(string(a)), gofvQuote(staticdata.StringSymName(string(a))))
+	case *AuxCall:
+		fn := "-"
+		if a.Fn != nil {
+			fn = x.auxRef(a.Fn)
+		}
+		ai := a.abiInfo
+		if ai == nil {
+			fmt.Fprintf(&b, "call %s %s - 0 0 0 0 0 0\n", gofvQuote(render), fn)
+			break
+		}
+		in, out := ai.InParams(), ai.OutParams()
+		fmt.Fprintf(&b, "call %s %s %d %d %d %d %d %d %d\n", gofvQuote(render), fn, ai.Config().Which(), len(in), len(out),
+			ai.SpillAreaOffset(), ai.SpillAreaSize(), ai.InRegistersUsed(), ai.OutRegistersUsed())
+		for dir, ps := range [][]abiParam{gofvParams(in), gofvParams(out)} {
+			d := "in"
+			if dir == 1 {
+				d = "out"
+			}
+			for i, p := range ps {
+				// Parameter names of callees are only read for f.OwnAux
+				// (ParamAssignmentForArgName); other functions' names are mutated
+				// while those functions are compiled concurrently, so they are omitted.
+				name := "-"
+				if p.name != nil && a == x.f.OwnAux {
+					name = x.auxRef(p.name)
+				}
+				fmt.Fprintf(&b, "abiparam %s %d %s %s %s %d\n", d, i, x.typ(p.t), name, p.regs, p.off)
+			}
+		}
+	case *AuxNameOffset:
+		fmt.Fprintf(&b, "nameoff %s %s %d\n", gofvQuote(render), x.auxRef(a.Name), a.Offset)
+	case *types.Type:
+		fmt.Fprintf(&b, "type %s %s\n", gofvQuote(render), x.typ(a))
+	case int64Aux:
+		fmt.Fprintf(&b, "int %s %d\n", gofvQuote(render), int64(a))
+	case auxMark:
+		fmt.Fprintf(&b, "mark %s\n", gofvQuote(render))
+	case PanicBoundsC:
+		fmt.Fprintf(&b, "pbc %s %d\n", gofvQuote(render), a.C)
+	case PanicBoundsCC:
+		fmt.Fprintf(&b, "pbcc %s %d %d\n", gofvQuote(render), a.Cx, a.Cy)
+	default:
+		fmt.Fprintf(&b, "unknown %s %s\n", gofvQuote(render), gofvQuote(fmt.Sprintf("%T", a)))
+	}
+	return b.String()
+}
+
+type abiParam struct {
+	t    *types.Type
+	name *ir.Name
+	regs string
+	off  int32
+}
+
+func gofvParams(ps []abi.ABIParamAssignment) []abiParam {
+	r := make([]abiParam, len(ps))
+	for i := range ps {
+		p := &ps[i]
+		regs := make([]string, len(p.Registers))
+		for j, reg := range p.Registers {
+			regs[j] = strconv.Itoa(int(reg))
+		}
+		r[i] = abiParam{p.Type, p.Name, gofvList(regs), p.GOFVRawOffset()}
+	}
+	return r
+}
+
+func (x *gofvExporter) symDef(b *strings.Builder, s *obj.LSym, render string) {
+	flags := gofvFlags(
+		[]string{"dupok", "local", "static", "contentaddressable", "wrapper", "abiwrapper"},
+		[]bool{s.DuplicateOK(), s.Local(), s.Static(), s.ContentAddressable(), s.Wrapper(), s.ABIWrapper()})
+	var tinfo, iinfo *types.Type
+	if ti := s.TypeInfo(); ti != nil {
+		tinfo, _ = ti.Type.(*types.Type)
+	}
+	if ii := s.ItabInfo(); ii != nil {
+		iinfo, _ = ii.Type.(*types.Type)
+	}
+	tref, iref := "-", "-"
+	if tinfo != nil {
+		tref = x.typ(tinfo)
+	}
+	if iinfo != nil {
+		iref = x.typ(iinfo)
+	}
+	// Only read-only data symbols are inspected by the passes (symIsRO, isFixedLoad, ...).
+	// Kind, size, flags and contents of other symbols change while other functions are
+	// compiled concurrently, so they are not exported (they would make the export
+	// nondeterministic).
+	kind, size, data, relocs := "-", int64(0), "-", []obj.Reloc(nil)
+	if s.Type == objabi.SRODATA {
+		kind, size, relocs = s.Type.String(), s.Size, s.R
+		if len(s.P) > 0 {
+			data = fmt.Sprintf("%x", s.P)
+		}
+	} else {
+		flags = "-"
+	}
+	fmt.Fprintf(b, "sym %s %s %d %s %d %s %s %s %s %d\n", gofvQuote(render), gofvQuote(s.Name), s.ABI(), kind, size,
+		flags, tref, iref, data, len(relocs))
+	for _, r := range relocs {
+		tn, ta := "", 0
+		if r.Sym != nil {
+			tn, ta = r.Sym.Name, int(r.Sym.ABI())
+		}
+		fmt.Fprintf(b, "reloc %d %d %s %d %s %d\n", r.Off, r.Siz, r.Type.String(), r.Add, gofvQuote(tn), ta)
+	}
+	if tinfo != nil {
+		t := tinfo
+		if t.GOFVSizeKnown() {
+			if want := "type:" + types.TypeSymName(t); want != s.Name {
+				x.warn("typeinfo sym %s: expected name %s", s.Name, want)
+			}
+		}
+		size, ptrdata, gcdata := "?", "?", "?"
+		if t.GOFVSizeKnown() {
+			size = strconv.FormatInt(t.Size(), 10)
+		}
+		if gofvDeepKnown(t) {
+			ptrdata = strconv.FormatInt(types.PtrDataSize(t), 10)
+			gcdata = gofvQuote(reflectdata.GOFVGCSymName(t))
+		}
+		elem := `""`
+		if t.IsPtr() && t.Elem() != nil && t.Elem().GOFVSizeKnown() {
+			elem = gofvQuote("type:" + types.TypeSymName(t.Elem()))
+		}
+		fmt.Fprintf(b, "rtype %s %s %d %d %s %s\n", size, ptrdata, int32(types.TypeHash(t)), int8(reflectdata.ABIKindOfType(t)), gcdata, elem)
+	}
+}
+
+// typs writes the types rules refer to by name: Config.Types (typ.* in rules), the
+// remaining basic types.Types[k] and the SSA pseudo-types.
+func (x *gofvExporter) typs(w *bytes.Buffer) {
+	ct := &x.f.Config.Types
+	named := []struct {
+		n string
+		t *types.Type
+	}{
+		{"Bool", ct.Bool}, {"Int8", ct.Int8}, {"Int16", ct.Int16}, {"Int32", ct.Int32}, {"Int64", ct.Int64},
+		{"UInt8", ct.UInt8}, {"UInt16", ct.UInt16}, {"UInt32", ct.UInt32}, {"UInt64", ct.UInt64},
+		{"Int", ct.Int}, {"Float32", ct.Float32}, {"Float64", ct.Float64}, {"UInt", ct.UInt},
+		{"Uintptr", ct.Uintptr}, {"String", ct.String}, {"BytePtr", ct.BytePtr}, {"Int32Ptr", ct.Int32Ptr},
+		{"UInt32Ptr", ct.UInt32Ptr}, {"IntPtr", ct.IntPtr}, {"UintptrPtr", ct.UintptrPtr},
+		{"Float32Ptr", ct.Float32Ptr}, {"Float64Ptr", ct.Float64Ptr}, {"BytePtrPtr", ct.BytePtrPtr},
+		{"Complex64", types.Types[types.TCOMPLEX64]}, {"Complex128", types.Types[types.TCOMPLEX128]},
+		{"UnsafePtr", types.Types[types.TUNSAFEPTR]},
+		{"Mem", types.TypeMem}, {"Flags", types.TypeFlags}, {"Void", types.TypeVoid},
+		{"Int128", types.TypeInt128}, {"ResultMem", types.TypeResultMem},
+	}
+	r := make([]string, 0, len(named))
+	for _, e := range named {
+		if e.t != nil {
+			r = append(r, e.n+"="+x.typ(e.t))
+		}
+	}
+	fmt.Fprintf(w, "typs %s\n", gofvList(r))
+}
+
+func (x *gofvExporter) slot(ls *LocalSlot) string {
+	if ls == nil {
+		return "-"
+	}
+	if n, ok := x.slots[ls]; ok {
+		return fmt.Sprintf("s%d", n)
+	}
+	n := len(x.slots) + 1
+	x.slots[ls] = n
+	name := x.auxRef(ls.N)
+	t := x.typ(ls.Type)
+	parent := x.slot(ls.SplitOf)
+	fmt.Fprintf(&x.defs, "slot s%d %s %s %d %s %d\n", n, name, t, ls.Off, parent, ls.SplitOffset)
+	return fmt.Sprintf("s%d", n)
+}
+
+// slotInline renders a LocalSlot value (a map key) inline.
+func (x *gofvExporter) slotInline(ls LocalSlot) string {
+	return fmt.Sprintf("%s/%s/%d/%s/%d", x.auxRef(ls.N), x.typ(ls.Type), ls.Off, x.slot(ls.SplitOf), ls.SplitOffset)
+}
+
+// slotOrder orders map entries holding *LocalSlot deterministically: slots that already
+// have a number by that number, the others after them by content (map iteration order is
+// random, and slot contents can coincide, e.g. for inlined copies of one variable).
+func (x *gofvExporter) slotOrder(ls *LocalSlot) string {
+	if n, ok := x.slots[ls]; ok {
+		return fmt.Sprintf("0%010d", n)
+	}
+	return "1" + gofvSlotKey(ls)
+}
+
+// slotValueOrder orders LocalSlot map keys: by the number of the slot's name if known,
+// then by content.
+func (x *gofvExporter) slotValueOrder(ls LocalSlot) string {
+	an := 1<<31 - 1
+	if n, ok := x.aux[ls.N]; ok {
+		an = n
+	}
+	return fmt.Sprintf("%010d|%s|%s", an, gofvSlotKey(&ls), x.slotOrder(ls.SplitOf))
+}
+
+// slotNum is the number of an already numbered slot (0 for nil).
+func (x *gofvExporter) slotNum(ls *LocalSlot) int {
+	if ls == nil {
+		return 0
+	}
+	return x.slots[ls]
+}
+
+// slotValueLess orders numbered LocalSlot values (map keys) by the numbers of their
+// fields: name, type, offset, split parent, split offset.
+func (x *gofvExporter) slotValueLess(a, b LocalSlot) bool {
+	if na, nb := x.aux[a.N], x.aux[b.N]; na != nb {
+		return na < nb
+	}
+	if ta, tb := x.types[a.Type], x.types[b.Type]; ta != tb {
+		return ta < tb
+	}
+	if a.Off != b.Off {
+		return a.Off < b.Off
+	}
+	if pa, pb := x.slotNum(a.SplitOf), x.slotNum(b.SplitOf); pa != pb {
+		return pa < pb
+	}
+	return a.SplitOffset < b.SplitOffset
+}
+
+// gofvSlotKey is a content key for a LocalSlot.
+func gofvSlotKey(ls *LocalSlot) string {
+	if ls == nil {
+		return "-"
+	}
+	name, pos := "", ""
+	if ls.N != nil {
+		if ls.N.Sym() != nil {
+			name = ls.N.Sym().Name
+		}
+		pos = fmt.Sprintf("%d:%d", ls.N.Pos().FileIndex(), ls.N.Pos().Line())
+	}
+	ts, _ := gofvTry(ls.Type.LinkString)
+	return fmt.Sprintf("%s@%s|%s|%d|%d|(%s)", name, pos, ts, ls.Off, ls.SplitOffset, gofvSlotKey(ls.SplitOf))
+}
+
+func (x *gofvExporter) values(vs []*Value) string {
+	r := make([]string, len(vs))
+	for i, v := range vs {
+		if v == nil {
+			r[i] = "nil"
+		} else {
+			r[i] = fmt.Sprintf("v%d", v.ID)
+		}
+	}
+	return gofvList(r)
+}
+
+func gofvEdges(es []Edge) string {
+	r := make([]string, len(es))
+	for i, e := range es {
+		r[i] = fmt.Sprintf("b%d:%d", e.b.ID, e.i)
+	}
+	return gofvList(r)
+}
+
+// section appends the current state of f as a section named after the pass just run.
+func (x *gofvExporter) section(name string) {
+	f := x.f
+	x.defs.Reset()
+	x.body.Reset()
+	x.warns = x.warns[:0]
+	w := &x.body
+
+	entry := "-"
+	if f.Entry != nil {
+		entry = fmt.Sprintf("b%d", f.Entry.ID)
+	}
+	ftyp := x.typ(f.Type)
+	var own string
+	if f.OwnAux == nil {
+		own = "-"
+	} else {
+		own = x.auxRef(f.OwnAux)
+	}
+	fmt.Fprintf(w, "f %s %s %s %d %d\n", entry, ftyp, own, f.vid.last, f.bid.last)
+	if x.nsec == 0 {
+		x.typs(w)
+	}
+	for _, b := range f.Blocks {
+		if b.CPUfeatures != 0 || b.FlagsLiveAtEnd || b.Hotness != 0 {
+			x.warn("b%d: CPUfeatures/FlagsLiveAtEnd/Hotness set", b.ID)
+		}
+		var ctl []*Value
+		for _, c := range b.Controls {
+			if c != nil {
+				ctl = append(ctl, c)
+			}
+		}
+		fmt.Fprintf(w, "b b%d %s %s %d %d %s %s %s %s\n", b.ID, b.Kind.String(), x.pos(b.Pos), b.Likely, b.AuxInt,
+			x.auxRef(b.Aux), x.values(ctl), gofvEdges(b.Succs), gofvEdges(b.Preds))
+		for _, v := range b.Values {
+			if v.Block != b {
+				x.warn("v%d listed in b%d but v.Block is %v", v.ID, b.ID, v.Block)
+			}
+			fmt.Fprintf(w, "v v%d %s %s %d %s %s %d %s\n", v.ID, v.Op.String(), x.typ(v.Type), v.AuxInt,
+				x.auxRef(v.Aux), x.pos(v.Pos), v.Uses, x.values(v.Args))
+		}
+	}
+
+	// Names and NamedValues.
+	names := make([]string, len(f.Names))
+	inNames := map[LocalSlot]bool{}
+	for i, ls := range f.Names {
+		names[i] = x.slot(ls)
+		inNames[*ls] = true
+	}
+	fmt.Fprintf(w, "names %s\n", gofvList(names))
+	for i, ls := range f.Names {
+		fmt.Fprintf(w, "named %s %s\n", names[i], x.values(f.NamedValues[*ls]))
+	}
+	var extra []LocalSlot
+	for k := range f.NamedValues {
+		if !inNames[k] {
+			extra = append(extra, k)
+		}
+	}
+	// Number every object first (in a deterministic content order), then order by numbers:
+	// the order then depends only on the map's contents and the (stable) numbers, not on
+	// which objects happened to be numbered before this section (#63).
+	sort.SliceStable(extra, func(i, j int) bool { return x.slotValueOrder(extra[i]) < x.slotValueOrder(extra[j]) })
+	for _, k := range extra {
+		x.slotInline(k)
+	}
+	sort.SliceStable(extra, func(i, j int) bool { return x.slotValueLess(extra[i], extra[j]) })
+	for _, k := range extra {
+		fmt.Fprintf(w, "namedx %s %s\n", x.slotInline(k), x.values(f.NamedValues[k]))
+	}
+
+	// Canonical slot maps.
+	type splitEnt struct {
+		k   LocalSlotSplitKey
+		v   *LocalSlot
+		key string
+	}
+	var splits []splitEnt
+	for k, v := range f.CanonicalLocalSplits {
+		ts, _ := gofvTry(k.Type.LinkString)
+		splits = append(splits, splitEnt{k, v, fmt.Sprintf("%s|%020d|%s|%s", x.slotOrder(k.parent), uint64(k.Off)^(1<<63), ts, x.slotOrder(v))})
+	}
+	sort.SliceStable(splits, func(i, j int) bool { return splits[i].key < splits[j].key })
+	for _, e := range splits {
+		x.slot(e.k.parent)
+		x.typ(e.k.Type)
+		x.slot(e.v)
+	}
+	sort.SliceStable(splits, func(i, j int) bool {
+		a, b := splits[i], splits[j]
+		if pa, pb := x.slotNum(a.k.parent), x.slotNum(b.k.parent); pa != pb {
+			return pa < pb
+		}
+		if a.k.Off != b.k.Off {
+			return a.k.Off < b.k.Off
+		}
+		if ta, tb := x.types[a.k.Type], x.types[b.k.Type]; ta != tb {
+			return ta < tb
+		}
+		return x.slotNum(a.v) < x.slotNum(b.v)
+	})
+	ss := make([]string, len(splits))
+	for i, e := range splits {
+		ss[i] = fmt.Sprintf("%s/%d/%s=%s", x.slot(e.k.parent), e.k.Off, x.typ(e.k.Type), x.slot(e.v))
+	}
+	fmt.Fprintf(w, "splits %s\n", gofvList(ss))
+	type canonEnt struct {
+		k   LocalSlot
+		v   *LocalSlot
+		key string
+	}
+	var canon []canonEnt
+	for k, v := range f.CanonicalLocalSlots {
+		canon = append(canon, canonEnt{k, v, x.slotOrder(v) + "|" + x.slotValueOrder(k)})
+	}
+	sort.SliceStable(canon, func(i, j int) bool { return canon[i].key < canon[j].key })
+	for _, e := range canon {
+		x.slotInline(e.k)
+		x.slot(e.v)
+	}
+	sort.SliceStable(canon, func(i, j int) bool {
+		a, b := canon[i], canon[j]
+		if x.slotValueLess(a.k, b.k) || x.slotValueLess(b.k, a.k) {
+			return x.slotValueLess(a.k, b.k)
+		}
+		return x.slotNum(a.v) < x.slotNum(b.v)
+	})
+	cs := make([]string, len(canon))
+	for i, e := range canon {
+		cs[i] = fmt.Sprintf("%s=%s", x.slotInline(e.k), x.slot(e.v))
+	}
+	fmt.Fprintf(w, "canon %s\n", gofvList(cs))
+
+	// Constant cache.
+	var keys []int64
+	for k, vs := range f.constants {
+		if len(vs) > 0 {
+			keys = append(keys, k)
+		}
+	}
+	slices.Sort(keys)
+	ks := make([]string, len(keys))
+	for i, k := range keys {
+		ks[i] = fmt.Sprintf("%d=%s", k, x.values(f.constants[k]))
+	}
+	fmt.Fprintf(w, "consts %s\n", gofvList(ks))
+
+	// Free lists.
+	var fv []string
+	for v := f.freeValues; v != nil; v = v.argstorage[0] {
+		fv = append(fv, fmt.Sprintf("v%d", v.ID))
+	}
+	fmt.Fprintf(w, "freev %s\n", gofvList(fv))
+	var fb []string
+	for b := f.freeBlocks; b != nil; b = b.succstorage[0].b {
+		fb = append(fb, fmt.Sprintf("b%d", b.ID))
+	}
+	fmt.Fprintf(w, "freeb %s\n", gofvList(fb))
+
+	// Cached CFG analyses.
+	if f.cachedPostorder != nil {
+		ps := make([]string, len(f.cachedPostorder))
+		for i, b := range f.cachedPostorder {
+			ps[i] = fmt.Sprintf("b%d", b.ID)
+		}
+		fmt.Fprintf(w, "cache postorder %s\n", gofvList(ps))
+	}
+	if f.cachedIdom != nil {
+		var is []string
+		for _, b := range f.Blocks {
+			if int(b.ID) >= len(f.cachedIdom) {
+				is = append(is, fmt.Sprintf("b%d:?", b.ID))
+				continue
+			}
+			if d := f.cachedIdom[b.ID]; d != nil {
+				is = append(is, fmt.Sprintf("b%d:b%d", b.ID, d.ID))
+			} else {
+				is = append(is, fmt.Sprintf("b%d:-", b.ID))
+			}
+		}
+		fmt.Fprintf(w, "cache idom %s\n", gofvList(is))
+	}
+	if f.cachedSdom != nil {
+		blk := func(b *Block) string {
+			if b == nil {
+				return "-"
+			}
+			return fmt.Sprintf("b%d", b.ID)
+		}
+		var ds []string
+		for _, b := range f.Blocks {
+			if int(b.ID) >= len(f.cachedSdom) {
+				ds = append(ds, fmt.Sprintf("b%d:?", b.ID))
+				continue
+			}
+			n := &f.cachedSdom[b.ID]
+			ds = append(ds, fmt.Sprintf("b%d:%s:%s:%s:%d:%d", b.ID, blk(n.parent), blk(n.child), blk(n.sibling), n.entry, n.exit))
+		}
+		fmt.Fprintf(w, "cache sdom %s\n", gofvList(ds))
+	}
+	if f.cachedLoopnest != nil {
+		fmt.Fprintf(w, "cache loopnest\n")
+	}
+	if f.auxmap != nil {
+		type auxEnt struct {
+			a  Aux
+			id int32
+		}
+		es := make([]auxEnt, 0, len(f.auxmap))
+		for a, id := range f.auxmap {
+			es = append(es, auxEnt{a, id})
+		}
+		sort.Slice(es, func(i, j int) bool { return es[i].id < es[j].id })
+		as := make([]string, len(es))
+		for i, e := range es {
+			as[i] = fmt.Sprintf("%s:%d", x.auxRef(e.a), e.id)
+		}
+		fmt.Fprintf(w, "cache auxmap %s\n", gofvList(as))
+	}
+	if ls := f.cachedLineStarts; ls != nil {
+		idx := make([]int32, 0, len(ls.maps))
+		for i := range ls.maps {
+			idx = append(idx, i)
+		}
+		slices.Sort(idx)
+		rs := make([]string, len(idx))
+		for j, i := range idx {
+			m := ls.maps[i]
+			if m == nil || m.s == nil {
+				rs[j] = fmt.Sprintf("%d:-", i)
+				continue
+			}
+			// Leftover pending statement lines (passes do not always clear them), in
+			// the sparse map's dense order.
+			es := make([]string, m.size())
+			for e := range m.size() {
+				l, v := m.getEntry(e)
+				es[e] = fmt.Sprintf(":%d=%d", l, v)
+			}
+			rs[j] = fmt.Sprintf("%d:%d:%d%s", i, m.first, m.cap()-1, strings.Join(es, ""))
+		}
+		fmt.Fprintf(w, "cache linestarts %s\n", gofvList(rs))
+	}
+
+	x.zvar(w)
+
+	fmt.Fprintf(&x.out, "pass %d %s\n", x.nsec, gofvQuote(name))
+	x.out.Write(x.defs.Bytes())
+	x.out.Write(x.body.Bytes())
+	for _, s := range x.warns {
+		fmt.Fprintf(&x.out, "warn %s\n", gofvQuote(s))
+	}
+	x.out.WriteString("end\n")
+	if x.set.gotext {
+		fmt.Fprintf(&x.text, "pass %d %s\n%s", x.nsec, gofvQuote(name), f.String())
+	}
+	x.nsec++
+}
+
+// finish writes the type order and the file.
+// frontend writes the definitions of the symbols reachable through R_ADDR/R_WEAKADDR
+// relocations of exported read-only symbols that no section defined: rewriteFixedLoad
+// folds a load from a read-only symbol to the relocation target, and the rewrite loop can
+// then fold a load from that target in turn (nested generic dictionaries), so a port needs
+// the targets' data although no section references them. The closure follows read-only
+// generic dictionaries ("..dict.") only; their other targets (type descriptors, itabs, ...)
+// are defined but not followed, which bounds the closure.
+func (x *gofvExporter) frontend() {
+	x.defs.Reset()
+	type numbered struct {
+		n int
+		s *obj.LSym
+	}
+	var syms []numbered
+	for a, n := range x.aux {
+		if s, ok := a.(*obj.LSym); ok {
+			syms = append(syms, numbered{n, s})
+		}
+	}
+	sort.Slice(syms, func(i, j int) bool { return syms[i].n < syms[j].n })
+	queue := make([]*obj.LSym, len(syms))
+	for i, e := range syms {
+		queue[i] = e.s
+	}
+	for len(queue) > 0 {
+		s := queue[0]
+		queue = queue[1:]
+		if s.Type != objabi.SRODATA || !strings.Contains(s.Name, "..dict.") {
+			continue
+		}
+		for _, r := range s.R {
+			if r.Sym == nil || r.Type != objabi.R_ADDR && r.Type != objabi.R_WEAKADDR {
+				continue
+			}
+			if _, done := x.aux[r.Sym]; done {
+				continue
+			}
+			x.auxRef(r.Sym)
+			queue = append(queue, r.Sym)
+		}
+	}
+	x.out.WriteString("frontend\n")
+	x.out.Write(x.defs.Bytes())
+	x.out.WriteString("end\n")
+}
+
+// zvar writes the type-object classes of zero-argument values (zcse keys them on the
+// *types.Type pointer, #63): types are numbered by identity, but the backend creates a fresh
+// *T object on every NewPtr (types.NewPtrCacheEnabled is false), so zero-argument values of
+// one type number can have distinct type objects. For every type number with at least two
+// distinct objects among the section's zero-argument values, each such value is listed
+// with the 1-based index of its object in order of first appearance (blocks, then values).
+func (x *gofvExporter) zvar(w *bytes.Buffer) {
+	type group struct {
+		objs []*types.Type
+		vals []*Value
+	}
+	groups := map[int]*group{}
+	for _, b := range x.f.Blocks {
+		for _, v := range b.Values {
+			if opcodeTable[v.Op].argLen != 0 || v.Type == nil {
+				continue
+			}
+			n := x.types[v.Type]
+			g := groups[n]
+			if g == nil {
+				g = &group{}
+				groups[n] = g
+			}
+			if !slices.Contains(g.objs, v.Type) {
+				g.objs = append(g.objs, v.Type)
+			}
+			g.vals = append(g.vals, v)
+		}
+	}
+	var es []string
+	for _, b := range x.f.Blocks {
+		for _, v := range b.Values {
+			if opcodeTable[v.Op].argLen != 0 || v.Type == nil {
+				continue
+			}
+			g := groups[x.types[v.Type]]
+			if len(g.objs) < 2 {
+				continue
+			}
+			es = append(es, fmt.Sprintf("v%d:%d", v.ID, slices.Index(g.objs, v.Type)+1))
+		}
+	}
+	if len(es) > 0 {
+		fmt.Fprintf(w, "zvar %s\n", strings.Join(es, ","))
+	}
+}
+
+// finish completes the file (tail) and writes it.
+func (x *gofvExporter) finish() {
+	x.tail()
+	x.write()
+}
+
+// tail appends the frontend block, file-level warns, typecmp and typeorder lines and eof.
+func (x *gofvExporter) tail() {
+	x.warns = x.warns[:0]
+	x.frontend()
+	for _, s := range x.warns {
+		fmt.Fprintf(&x.out, "warn %s\n", gofvQuote(s))
+	}
+	ts := slices.Clone(x.typeList)
+	cmp := func(a, b *types.Type) types.Cmp {
+		c, ok := gofvTry(func() types.Cmp { return a.Compare(b) })
+		if !ok {
+			return types.CMPeq
+		}
+		return c
+	}
+	sort.SliceStable(ts, func(i, j int) bool { return cmp(ts[i], ts[j]) == types.CMPlt })
+	var groups []string
+	rank := make(map[*types.Type]int, len(ts))
+	for i, t := range ts {
+		ref := fmt.Sprintf("t%d", x.types[t])
+		if i > 0 && cmp(ts[i-1], t) == types.CMPeq {
+			groups[len(groups)-1] += "=" + ref
+		} else {
+			groups = append(groups, ref)
+		}
+		rank[t] = len(groups)
+	}
+	// Compare is not a total preorder (*byte == *uint8 by the byte/uint8 special case, but
+	// cmpsym orders by name length, so *abi.Kind sorts between them): list every pair whose
+	// Compare disagrees with the rank order (#68). typeList is in number order.
+	cmpName := map[types.Cmp]string{types.CMPlt: "lt", types.CMPeq: "eq", types.CMPgt: "gt"}
+	for i, a := range x.typeList {
+		for _, b := range x.typeList[i+1:] {
+			want := types.CMPeq
+			switch ra, rb := rank[a], rank[b]; {
+			case ra < rb:
+				want = types.CMPlt
+			case ra > rb:
+				want = types.CMPgt
+			}
+			if c := cmp(a, b); c != want {
+				fmt.Fprintf(&x.out, "typecmp t%d t%d %s\n", x.types[a], x.types[b], cmpName[c])
+			}
+		}
+	}
+	fmt.Fprintf(&x.out, "typeorder %s\neof\n", gofvList(groups))
+	x.resolveTypes()
+}
+
+// write writes the finished file under the export directory.
+// gofvWritten records the files this compile wrote (backend goroutines write
+// concurrently), by stem, so that functions sharing a name get deterministic file names.
+var gofvWritten = struct {
+	sync.Mutex
+	m map[string]string // stem -> path of the unsuffixed file, "" once suffixed
+}{m: map[string]string{}}
+
+func (x *gofvExporter) write() {
+	dir := filepath.Join(x.set.dir, filepath.FromSlash(base.Ctxt.Pkgpath))
+	if err := os.MkdirAll(dir, 0o777); err != nil {
+		base.Fatalf("gofv export: %v", err)
+	}
+	stem := filepath.Join(dir, gofvFileName(x.f.Name)+","+strconv.Itoa(int(x.f.ABISelf.Which())))
+	// The first function of a name gets <stem>.ssa. When a second one arrives (the order
+	// depends on concurrent compilation), every function of that name is renamed to
+	// <stem>#<first 16 hex digits of the SHA-256 of its file>.ssa, so the set of files
+	// does not depend on the order.
+	gofvWritten.Lock()
+	defer gofvWritten.Unlock()
+	path := stem + ".ssa"
+	if first, seen := gofvWritten.m[stem]; seen {
+		if first != "" {
+			data, err := os.ReadFile(first)
+			if err != nil {
+				base.Fatalf("gofv export: %v", err)
+			}
+			moved := gofvHashedPath(stem, data)
+			if err := os.Rename(first, moved); err != nil {
+				base.Fatalf("gofv export: %v", err)
+			}
+			if x.set.gotext {
+				os.Rename(first+".txt", moved+".txt")
+			}
+			gofvWritten.m[stem] = ""
+		}
+		path = gofvHashedPath(stem, x.out.Bytes())
+	} else {
+		gofvWritten.m[stem] = path
+	}
+	fd, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o666)
+	if err == nil {
+		_, err = fd.Write(x.out.Bytes())
+		if cerr := fd.Close(); err == nil {
+			err = cerr
+		}
+	}
+	if err == nil && x.set.gotext {
+		err = os.WriteFile(path+".txt", x.text.Bytes(), 0o666)
+	}
+	if err != nil {
+		base.Fatalf("gofv export: %v", err)
+	}
+}
+
+func gofvHashedPath(stem string, data []byte) string {
+	return fmt.Sprintf("%s#%x.ssa", stem, sha256.Sum256(data))[:len(stem)+1+16] + ".ssa"
+}
+
+func gofvFileName(s string) string {
+	var b strings.Builder
+	for i := range len(s) {
+		c := s[i]
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '.' || c == '_' || c == '-' {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	r := b.String()
+	if len(r) > 160 {
+		// Long generic instantiation names exceed NAME_MAX: keep a prefix and a hash.
+		r = fmt.Sprintf("%s~%x", r[:120], sha256.Sum256([]byte(s)))[:120+1+16]
+	}
+	return r
+}
