+// gofvBackImport runs the back end on x's function and installs its result; one line per
+// function goes to GOFV_SSA_DRIVER_STATS: "<pkg>" "<func>" <abi> back=lean|stock and, for
+// stock, the event (exec, parse, status, resolve or check) with its detail.
+func gofvBackImport(x *gofvProgExporter) {
+	f := x.f
+	path, dump := ssa.GOFVDriverPath()
+	in := slices.Concat(f.GOFVBack(), gofvProgInput(x.out.Bytes()))
+	cmd := exec.Command(path, "--back", "/dev/stdin")
+	cmd.Stdin = bytes.NewReader(in)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, err := cmd.Output()
+	if dump != "" {
+		stem := filepath.Join(dump, filepath.FromSlash(base.Ctxt.Pkgpath),
+			fmt.Sprintf("%s,%d.back", ssa.GOFVFileName(f.Name), f.ABISelf.Which()))
+		if os.MkdirAll(filepath.Dir(stem), 0o777) == nil {
+			os.WriteFile(stem+".in", in, 0o666)
+			os.WriteFile(stem+".out", out, 0o666)
+		}
+	}
+	var kind string
+	if err != nil {
+		kind = "exec"
+		err = fmt.Errorf("%v: %s", err, strings.TrimSpace(stderr.String()))
+	} else {
+		var res *gofvBackResult
+		if res, kind, err = gofvParseBack(out); err == nil {
+			kind, err = gofvBackInstall(x, res)
+		}
+	}
+	line := fmt.Sprintf("%s\t%s\t%d\t", strconv.Quote(base.Ctxt.Pkgpath), strconv.Quote(f.Name), f.ABISelf.Which())
+	if err == nil {
+		line += "back=lean"
+	} else {
+		msg := err.Error()
+		if len(msg) > 400 {
+			msg = msg[:400] + "…"
+		}
+		line += "back=stock\t" + kind + " " + strconv.Quote(msg)
+	}
+	ssa.GOFVAppendStats(line)
+}
