  { x := fun k => if k = 2 then GenG2.symA else if k = 28 then 0x9000
      else if k = 29 then GenG2.sp0 - 8 else 0,
    sp := GenG2.sp0, v := fun _ => 0, nzcv := ⟨false, false, false, false⟩,
    pc := E.pcOf 1 5, mem := fun _ => 0 }

/-- The indirect call `v` has no result register. -/
def noOutsI (lc : LocCtx) (v : Value) : Bool :=
  match callABI? lc.ctx.tabs v.aux with
  | some cabi =>
    match callRegs cabi with
    | .ok (_, outs) => outs.isEmpty
    | .error _ => false
  | none => false

/-- The code pointer of `v` (argument 0) reads as the start of a global. -/
def codeGlobal (lc : LocCtx) (s : LocState) (v : Value) : Bool :=
  match v.args[0]? with
  | some a0 =>
    match s.read lc a0 with
    | .ok (.ptr p) =>
      match p.blk with
      | .global _ => p.off == 0
      | _ => false
    | _ => false
  | none => false

/-- What compiled evaluation checks on `Locker.Lock`: `checkG10` accepts it with `tab` and `kt`
and `checkG9` does not; it accesses no frame variable and has no home slot; `b1` holds `v11` and
`v12` at 5 and 6; their ops; `v11` has no result register and its code pointer reads as the start
of a global from `s0`; `R0` and `R2` hold 64-bit values before `v11`; and `stepLoc` runs `v11` (to
the memory `mem0`) and `v12` from `s0`. -/
def gFacts : Bool :=
  (checkG10 lc ps bs g).toOption == some (tab, kt) && (checkG9 lc ps bs g).toOption.isNone &&
    (accessedVars lc).isEmpty && (homeSlots lc).isEmpty &&
    lc.ctx.f.blocks.toList.contains 1 && (lc.ctx.f.block? 1).isSome &&
    (lc.ctx.f.value? 11).isSome && (lc.ctx.f.value? 12).isSome &&
    blk1.values[5]? == some 11 && blk1.values[6]? == some 12 &&
    (val 11).op == .ARM64CALLinter && (val 12).op == .SelectN &&
    noOutsI lc (val 11) && codeGlobal lc s0 (val 11) &&
    (kAt lc kt 1 blk1 5).get 0 == some 64 && (kAt lc kt 1 blk1 5).get 2 == some 64 &&
    GenG1.okThen (stepLoc GenG2.env lc s0 (val 11)) fun s1 =>
      GenG2.memIs0 s1.mem && GenG1.okThen (stepLoc GenG2.env lc s1 (val 12)) fun _ => true

theorem g10_facts : gFacts = true := by
  native_decide

/-- The facts of `g10_facts` as hypotheses. -/
theorem facts :
    checkG10 lc ps bs g = .ok (tab, kt) ∧ (accessedVars lc).isEmpty = true ∧
      (homeSlots lc).isEmpty = true ∧ 1 ∈ lc.ctx.f.blocks.toList ∧
      lc.ctx.f.block? 1 = some blk1 ∧ lc.ctx.f.value? 11 = some (val 11) ∧
      lc.ctx.f.value? 12 = some (val 12) ∧
      blk1.values[5]? = some 11 ∧ blk1.values[6]? = some 12 ∧
      (val 11).op = .ARM64CALLinter ∧ (val 12).op = .SelectN ∧
      noOutsI lc (val 11) = true ∧ codeGlobal lc s0 (val 11) = true ∧
      (kAt lc kt 1 blk1 5).get 0 = some 64 ∧ (kAt lc kt 1 blk1 5).get 2 = some 64 ∧
      (GenG1.okThen (stepLoc GenG2.env lc s0 (val 11)) fun s1 =>
        GenG2.memIs0 s1.mem && GenG1.okThen (stepLoc GenG2.env lc s1 (val 12)) fun _ => true) =
        true := by
  have hf := g10_facts
  simp only [gFacts, Bool.and_eq_true, beq_iff_eq, List.contains_iff_mem] at hf
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hres, -⟩, hav⟩, hsl⟩, hm1⟩, hb1s⟩, hv11⟩, hv12⟩, hi5⟩, hi6⟩, hop11⟩,
    hop12⟩, hout⟩, hcode⟩, hk0⟩, hk2⟩, hrun⟩ := hf
  have hval : ∀ n, (lc.ctx.f.value? n).isSome = true → lc.ctx.f.value? n = some (val n) := by
    intro n h
    obtain ⟨v, hv⟩ := Option.isSome_iff_exists.1 h
    simp [val, hv]
  refine ⟨?_, hav, hsl, hm1, ?_, hval _ hv11, hval _ hv12, hi5, hi6, hop11, hop12, hout, hcode,
    hk0, hk2, hrun⟩
  · revert hres; cases checkG10 lc ps bs g <;> simp [Except.toOption]
  · obtain ⟨b, hb⟩ := Option.isSome_iff_exists.1 hb1s
    simp [blk1, hb]

theorem g10Env (hc : checkG10 lc ps bs g = .ok (tab, kt)) (hav : (accessedVars lc).isEmpty = true)
    (hsl : (homeSlots lc).isEmpty = true) : G10Env lc g L ps 0 tab E where
  env := {
    env := {
      env := {
        lcEq := rfl
        link := rfl
        pcOf := rfl
        retOut := by
          obtain ⟨-, -, -, -, -, -, -, -, -, -, -, hlt, -, -⟩ := checkG10_spec hc
          intro p hp
          exact GenG2.prog_addr_ne (hlt p hp) hp (by simp) (by simp)
        addr := GenG2.addrAgree
        glob := fun _ _ _ _ => rfl
        syms := by
          obtain ⟨-, -, -, -, -, -, -, -, -, -, -, hlt, -, -⟩ := checkG10_spec hc
          intro y
          have hs : L.sym y = GenG2.symA := rfl
          rw [hs]
          refine ⟨by decide, fun p hp => ?_⟩
          exact GenG2.prog_addr_ne (hlt p hp) hp (Or.inr (by decide)) (by decide)
        calls := fun h => by cases h
        slot := fun k hk => by simp [List.isEmpty_iff.1 hsl] at hk
        extra := by decide
        frame := ⟨by decide, by decide, fun k off h => by cases h⟩ }
      vars := by
        intro x hx
        simp [List.isEmpty_iff.1 hav] at hx }
    wbs := fun h => by cases h }
  icalls := fun h => by cases h

theorem locMatch0 : LocMatch E s0 1 5 m0 where
  regs := by
    intro r v hv
    simp only [s0, Array.getElem?_ofFn] at hv
    split at hv
    · simp only [Option.some.injEq] at hv
      split at hv
      · rename_i h0
        subst hv
        refine ⟨fun k hk => ?_, fun k hk => ?_⟩
        · obtain rfl : r = 0 := h0
          simp only [objX?] at hk
          cases hk
          exact ⟨0, rfl, by decide⟩
        · obtain rfl : r = 0 := h0
          simp [objV?] at hk
      · split at hv
        · rename_i _ h2
          subst hv
          refine ⟨fun k hk => ?_, fun k hk => ?_⟩
          · obtain rfl : r = 2 := h2
            simp only [objX?] at hk
            cases hk
            exact ⟨GenG2.symA, rfl, by decide⟩
          · obtain rfl : r = 2 := h2
            simp [objV?] at hk
        · subst hv
          exact ⟨fun _ _ => trivial, fun _ _ => trivial⟩
    · cases hv
  flags := trivial
  slots := by intro k v h; simp [s0] at h
  mem := ⟨GenG2.mem0, rfl, GenG2.memInj0 rfl _⟩
  frame := ⟨rfl, rfl, fun _ => ⟨rfl, by simp only [MState.word, readMem, m0, E]; decide,
    by simp only [MState.word, readMem, m0, E]; decide⟩,
    fun h => by cases h⟩
  pc := rfl

theorem g10Inv0 {K : KMap} (h0 : K.get 0 = some 64) (h2 : K.get 2 = some 64) :
    G3Inv E lc K s0 where
  core := by
    refine ⟨fun r v c hr hv hc => ?_, GenG2.mem0, rfl, GenG2.keys0, GenG2.sep0⟩
    simp only [s0, Array.getElem?_ofFn] at hv
    split at hv
    · simp only [Option.some.injEq] at hv
      split at hv
      · rename_i h0'
        subst hv
        obtain rfl : r = 0 := h0'
        rw [h0] at hc; cases hc; rfl
      · split at hv
        · rename_i _ h2'
          subst hv
          obtain rfl : r = 2 := h2'
          rw [h2] at hc; cases hc; rfl
        · subst hv; trivial
    · cases hv
  slots := by intro k v h; simp [s0] at h

/-- No `Link.byId` address of Progs with IDs below `2^32` is `symA`. -/
theorem addr_ne_symA {qs : List GoFV.Asm.Prog} {az ez : Int} (hlt : ∀ p ∈ qs, p.id < 2 ^ 32)
    (id : Nat) : (Link.byId (fun _ => GenG2.symA) GenG2.text az ez qs).addr id ≠ some GenG2.symA := by
  intro h
  cases hf : qs.find? (·.id = id) with
  | none => simp [Link.addr, Link.byId, Link.ofProgs, hf] at h
  | some p =>
    have hp := List.mem_of_find?_eq_some hf
    have hid : p.id = id := by simpa using List.find?_some hf
    subst hid
    exact GenG2.prog_addr_ne (hlt p hp) hp (Or.inr (by decide)) (by decide) h

theorem noOutsI_spec {lc' : LocCtx} {v : Value} {cabi : CallABI} {ins outs : List Nat}
    (h : noOutsI lc' v = true) (hc : callABI? lc'.ctx.tabs v.aux = some cabi)
    (hcr : callRegs cabi = .ok (ins, outs)) : outs = [] := by
  simp only [noOutsI, hc, hcr, List.isEmpty_iff] at h
  exact h

theorem codeGlobal_spec {lc' : LocCtx} {s : LocState} {v : Value} {a0 : ID}
    (h : codeGlobal lc' s v = true) (ha0 : v.args[0]? = some a0) :
    ∃ n, s.read lc' a0 = .ok (.ptr ⟨.global n, 0⟩) := by
  unfold codeGlobal at h
  simp only [ha0] at h
  split at h
  next p hp =>
    split at h
    next n hb =>
      have h0 : p.off = 0 := by simpa using h
      refine ⟨n, ?_⟩
      rw [hp]
      obtain ⟨blk, off⟩ := p
      simp only at hb h0
      subst hb h0
      rfl
    next => cases h
  next => cases h

/-- The callee contract of `GenG2.H0` at an interface call with no result register whose code
pointer reads as the start of a global: the PC is `symA` (the globals' address), no Prog address
nor the return address, and the hook returns to `X30` with the memory `mem0` (stated for any
context, so that the kernel never evaluates the parsed function). -/
theorem icallOKc {lc' : LocCtx} {L' : Link} {v : Value} {E' : MatchEnv} {ret : BitVec 64}
    (hA : AddrAgree E'.ι) (hnil : E'.ι .nil = some 0)
    (hglob : ∀ n, E'.ι (.global n) = some GenG2.symA) (hret : ret ≠ GenG2.symA)
    (haddr : ∀ id, L'.addr id ≠ some GenG2.symA)
    {s s' : LocState} {m : MState} (hmem : GenG2.memIs0 s'.mem = true)
    (hcode : codeGlobal lc' s v = true) (hno : noOutsI lc' v = true) :
    ICallOK GenG2.H0 E' L' ret lc' s s' v m := by
  intro n cabi ins outs a0 rc q args mm m₁ _ hc hcr ha0 _ _ _ hrel _ _ _ _ _ _ _ _ _
  obtain ⟨nm, hrd⟩ := codeGlobal_spec hcode ha0
  obtain ⟨a, ha, hpca⟩ := hrel _ hrd
  rw [hglob] at ha
  cases ha
  have hpc : m₁.pc = GenG2.symA := by rw [hpca]; simp
  have hout := noOutsI_spec hno hc hcr
  have hm' : s'.mem = .mem GenG2.mem0 := by
    unfold GenG2.memIs0 at hmem
    split at hmem
    · rename_i mm' he
      rw [he, of_decide_eq_true hmem]
    · cases hmem
  subst hout
  refine ⟨by rw [hpc]; exact Ne.symm hret, fun id => by rw [hpc]; exact haddr id, ?_⟩
  intro _ _ _ _ _
  exact ⟨E'.ι, { m₁ with pc := m₁.x 30 }, GenG2.mem0, rfl, fun _ _ h => h, hA, rfl, rfl, rfl, rfl,
    fun _ _ => rfl, hm', GenG2.memInj0 hnil _, GenG2.keys0, GenG2.sep0, fun r hr => by cases hr⟩

/-- An op other than an interface or closure call: `ICallOK` holds vacuously. -/
theorem icallOK_ne {E' : MatchEnv} {L' : Link} {ret : BitVec 64} {lc' : LocCtx}
    {s s' : LocState} {v : Value} {m : MState} (h : icallLead v.op = none) :
    ICallOK GenG2.H0 E' L' ret lc' s s' v m := by
  intro n _ _ _ _ _ _ _ _ _ hn
  rw [h] at hn
  cases hn

theorem callOK_ne {E' : MatchEnv} {s s' : LocState} {v : Value} {m : MState}
    (h : v.op ≠ .ARM64CALLstatic) : CallOK GenG2.H0 E' g L lc s s' v m :=
  fun hop => absurd hop h

theorem wbOK_ne {E' : MatchEnv} {s : LocState} {v : Value} {m : MState}
    (h : v.op ≠ .ARM64LoweredWB) : WbOK GenG2.H0 E' g L lc s v m :=
  fun hop => absurd hop h

theorem g7Pre_of {v : Value} (h1 : v.op ≠ .ARM64CMP) (h2 : v.op ≠ .ARM64CMPconst)
    (h3 : loadOp? v.op = none) (h4 : v.op ≠ .ARM64LDP) (h5 : v.op ≠ .ARM64SUB)
    (h6 : v.op ≠ .ARM64LoweredNilCheck) (s : LocState) : G7Pre lc s v :=
  ⟨⟨⟨fun h => by rcases h with h | h <;> contradiction,
    (fun _ _ _ hl => by rw [h3] at hl; cases hl), fun h => absurd h h5⟩, fun h => absurd h h4⟩,
    fun h => absurd h h6⟩

/-- **G10 on `Locker.Lock`**: from the state before the interface call `v11` (the nil data word in
`R0`, the code pointer of a global function in `R2`), the call and its memory `v12` are matched
by a machine run of the Progs through `CALL (R2)` and the callee hook at the address in `X2` to a
state related before `v13`, with the registers at their classes, under an activation that extends
`E` and is a `G10Env`. -/
theorem genG10_value_witness :
    ∃ s1 s2 E' m2, stepLoc GenG2.env lc s0 (val 11) = .ok s1 ∧
      stepLoc GenG2.env lc s1 (val 12) = .ok s2 ∧
      E.Extends E' ∧ G10Env lc g L ps 0 tab E' ∧ PStar GenG2.H0 L ps.toList 0 m0 m2 ∧
      LocMatch E' s2 1 7 m2 ∧ G3Inv E' lc (kAt lc kt 1 blk1 7) s2 := by
  obtain ⟨hc, hav, hsl, hm1, hb, hv11, hv12, hi5, hi6, hop11, hop12, hout, hcode, hk0, hk2,
    hrun⟩ := facts
  obtain ⟨s1, hs1, hrun⟩ := GenG1.okThen_spec hrun
  simp only [Bool.and_eq_true] at hrun
  obtain ⟨hmem, hrun⟩ := hrun
  obtain ⟨s2, hs2, -⟩ := GenG1.okThen_spec hrun
  have hE := g10Env hc hav hsl
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, hlt, -, -⟩ := checkG10_spec hc
  obtain ⟨E1, m1, hx1, hE1, hp1, hm1', hinv1⟩ := g10_value (H := GenG2.H0) (env := GenG2.env) hc
    hE hm1 hb hi5 hv11 (by rw [hop11]; rfl) locMatch0 (g10Inv0 hk0 hk2)
    (g7Pre_of (by rw [hop11]; decide) (by rw [hop11]; decide)
      (by rw [hop11]; simp [loadOp?, narrowLoad?]) (by rw [hop11]; decide)
      (by rw [hop11]; decide) (by rw [hop11]; decide) _)
    (callOK_ne (by rw [hop11]; decide))
    (icallOKc GenG2.addrAgree rfl (fun _ => rfl) (by decide) (addr_ne_symA hlt) hmem hcode hout)
    (wbOK_ne (by rw [hop11]; decide)) hs1
  obtain ⟨E2, m2, hx2, hE2, hp2, hm2, hinv2⟩ := g10_value (H := GenG2.H0) (env := GenG2.env) hc
    hE1 hm1 hb hi6 hv12 (by rw [hop12]; rfl) hm1' hinv1
    (g7Pre_of (by rw [hop12]; decide) (by rw [hop12]; decide)
      (by rw [hop12]; simp [loadOp?, narrowLoad?]) (by rw [hop12]; decide)
      (by rw [hop12]; decide) (by rw [hop12]; decide) _)
    (callOK_ne (by rw [hop12]; decide)) (icallOK_ne (by rw [hop12]; rfl))
    (wbOK_ne (by rw [hop12]; decide)) hs2
  exact ⟨s1, s2, E2, m2, hs1, hs2, MatchEnv.Extends.trans hx1 hx2, hE2, hp1.trans hp2, hm2,
    hinv2⟩

end GoFV.Proof.Witness.GenG10
