/-- The Go value: portable opcodes from 0, arm64 opcodes from `obj.ABaseARM64 +
obj.A_ARCHSPECIFIC` = 10240 + 15. -/
def goNum (a : As) : Nat :=
  let i := a.ctorIdx
  if i < 15 then i else i + 10240

/-- Opcodes by name. -/
def byName : Std.HashMap String As :=
  all.foldl (fun m a => m.insert a.name a) {}

/-- The opcode named `s` (`As.String()` spelling), if any. -/
def ofName? (s : String) : Option As := byName[s]?

end As

instance : ToString As := ⟨As.name⟩
instance : Repr As := ⟨fun a _ => .text ("GoFV.Asm.As." ++ a.name)⟩

end GoFV.Asm
